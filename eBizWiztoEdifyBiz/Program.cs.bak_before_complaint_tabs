            {
                string t = LookInt(payTermName, Int(r["nmstpayterms"])); if (t.Length == 0) t = "Term " + Int(r["nmstpayterms"]);
                if (r["npercentage"] != DBNull.Value) t += " " + Dec(r["npercentage"]).ToString("0.##", CultureInfo.InvariantCulture) + "%";
                if (r["namount"] != DBNull.Value) t += " = " + Dec(r["namount"]).ToString("0.00", CultureInfo.InvariantCulture);
