        // ---------- contract index: serial -> migrated contractdetails, and the PMS rows to update ----------
        static void BuildContractIndex(SqlConnection tgt)
        {
            // migrated contract lines, keyed contractno|srno|productcode (how module 10 wrote them). A contract can hold the
            // same serial + product twice, so each key keeps a QUEUE and the source serial rows consume it in insert order. - Aftab Alam
            Dictionary<string, Queue<Det>> tgtDet = new Dictionary<string, Queue<Det>>(StringComparer.OrdinalIgnoreCase);
            foreach (DataRow r in GetTgt(@"SELECT cd.code, cd.productcode, ISNULL(cd.srno,'') AS srno, cd.startdate, cd.enddate, a.contractno, a.ccode
                                           FROM contractdetails cd JOIN amc a ON a.code = cd.contractcode ORDER BY cd.code").Tables[0].Rows)
            {
                string k = Str(r["contractno"]) + "|" + Str(r["srno"]) + "|" + Int(r["productcode"]);
                Queue<Det> q; if (!tgtDet.TryGetValue(k, out q)) tgtDet[k] = q = new Queue<Det>();
                q.Enqueue(new Det { Code = Int(r["code"]), Ccode = Int(r["ccode"]), Pcode = Int(r["productcode"]), Srno = Str(r["srno"]), Start = Date(r["startdate"]), End = Date(r["enddate"]) });
            }
            Dictionary<string, Det> lastDet = new Dictionary<string, Det>(StringComparer.OrdinalIgnoreCase);
            // source: contract no per contract, product per product line
            Dictionary<string, string> contrNo = new Dictionary<string, string>();
            foreach (DataRow r in GetSrc("SELECT nofficeid, ncode, vtrnprefix, ntrnno FROM trhcontr WITH (NOLOCK) WHERE nofficeid IN (" + OfficeIn + ")").Tables[0].Rows)
                contrNo[Int(r["nofficeid"]) + "|" + Int(r["ncode"])] = (Str(r["vtrnprefix"]) + Str(r["ntrnno"])).Trim();
            Dictionary<string, int> itemByLine = new Dictionary<string, int>();
            foreach (DataRow r in GetSrc("SELECT nofficeid, ncode, nitem FROM trdcontr1items WITH (NOLOCK) WHERE nofficeid IN (" + OfficeIn + ")").Tables[0].Rows)
                itemByLine[Int(r["nofficeid"]) + "|" + Int(r["ncode"])] = Int(r["nitem"]);

            foreach (DataRow r in GetSrc(@"SELECT nofficeid, ncontr, ncontr1, ncode, nitemserialno, vserialno
                                           FROM trdcontr2itemsdet WITH (NOLOCK) WHERE nofficeid IN (" + OfficeIn + ") ORDER BY nofficeid, ncontr, ncode").Tables[0].Rows)
            {
                int office = Int(r["nofficeid"]);
                string cno; if (!contrNo.TryGetValue(office + "|" + Int(r["ncontr"]), out cno)) continue;
                int item; if (!itemByLine.TryGetValue(office + "|" + Int(r["ncontr1"]), out item)) continue;
                int pcode; if (!_prodByItem.TryGetValue(item, out pcode)) continue;
                string dk = cno + "|" + Cap(Str(r["vserialno"]), 50) + "|" + pcode;
                Queue<Det> dq; Det d;
                if (tgtDet.TryGetValue(dk, out dq) && dq.Count > 0) { d = dq.Dequeue(); lastDet[dk] = d; }
                else if (!lastDet.TryGetValue(dk, out d)) continue;      // contract line not migrated (product missing / orphan serial)
                _detBySrcRow[office + "|" + Int(r["ncode"])] = d;
                string sk = NKey(r["nitemserialno"]); if (sk.Length == 0) continue;
                List<Det> l; if (!_detBySerial.TryGetValue(sk, out l)) _detBySerial[sk] = l = new List<Det>();
                if (!l.Any(x => x.Code == d.Code)) l.Add(d);
            }

            // PMS rows written by module 10. Their identity is the number module 10 built: "PMS" + contractdetails.code (7 digits)
            // + "_" + the visit's 0-based index inside that serial, in the same order (nofficeid, ncontr2, dschpmdate, ncode).
            // Matching on (contractdtcode | scheduled date) was not unique - 28 serials have two PM visits on the SAME date
            // (62 calls), so the second call could not find its row. The number is unique, the date stays only as a fallback. - Aftab Alam
            Dictionary<string, int> pmsByNo = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
            Dictionary<string, Queue<int>> pmsByDate = new Dictionary<string, Queue<int>>();
            foreach (DataRow r in GetTgt("SELECT code, contractdtcode, date, ISNULL(pmscomplaintno,'') AS no FROM contractcall WHERE type='PMS' AND contractdtcode IS NOT NULL ORDER BY code").Tables[0].Rows)
            {
                string no = Str(r["no"]); if (no.Length > 0 && !pmsByNo.ContainsKey(no)) pmsByNo[no] = Int(r["code"]);
                if (r["date"] == DBNull.Value) continue;
                string k = Int(r["contractdtcode"]) + "|" + Convert.ToDateTime(r["date"]).ToString("yyyyMMddHHmmss");
                Queue<int> q; if (!pmsByDate.TryGetValue(k, out q)) pmsByDate[k] = q = new Queue<int>();
                q.Enqueue(Int(r["code"]));
            }
            HashSet<int> used = new HashSet<int>();
            Dictionary<string, int> kBySerial = new Dictionary<string, int>();
            foreach (DataRow r in GetSrc("SELECT nofficeid, ncontr2, dschpmdate, ncalls FROM trdcontr7pmvisit WITH (NOLOCK) WHERE nofficeid IN (" + OfficeIn + ") ORDER BY nofficeid, ncontr2, dschpmdate, ncode").Tables[0].Rows)
            {
                int office = Int(r["nofficeid"]); string serialKey = office + "|" + Int(r["ncontr2"]);
                int k; kBySerial.TryGetValue(serialKey, out k);       // 0-based index inside the serial, as module 10 counted it
                kBySerial[serialKey] = k + 1;
                if (Int(r["ncalls"]) == 0) continue;
                Det d; if (!_detBySrcRow.TryGetValue(serialKey, out d)) continue;
                int cc;
                if (!pmsByNo.TryGetValue("PMS" + d.Code.ToString("0000000") + "_" + k, out cc))
                {
                    if (r["dschpmdate"] == DBNull.Value) continue;
                    Queue<int> q;
                    if (!pmsByDate.TryGetValue(d.Code + "|" + Convert.ToDateTime(r["dschpmdate"]).ToString("yyyyMMddHHmmss"), out q)) continue;
                    while (q.Count > 0 && used.Contains(q.Peek())) q.Dequeue();
                    if (q.Count == 0) continue;
                    cc = q.Dequeue();
                }
                string ck = office + "|" + Int(r["ncalls"]);
                if (_pmsByCall.ContainsKey(ck) || used.Contains(cc)) continue;      // one PMS row per call
                _pmsByCall[ck] = cc; used.Add(cc);
            }

            // ---- Warranty contracts (module 10 WarrantyContract): sold serials + their PM visits ----
            // Lines keyed sal_order.code|srno|productcode (queue, insert order); source serial rows re-read in the same
            // (nofficeid, nsales, ncode) order, so each serial finds its own warranty line. A call on a sold serial then links
            // to the warranty (or the AMC contract covering the call date - ResolveDet), and a PM VISIT call updates its
            // warranty PMS row instead of becoming a new Walk In. - Aftab Alam
            int warrType = WarrantyContract.WarrantyType(tgt), wLines = 0, wPm = 0;
            Dictionary<string, Queue<Det>> wDet = new Dictionary<string, Queue<Det>>(StringComparer.OrdinalIgnoreCase);
            foreach (DataRow r in GetTgt(@"SELECT cd.code, cd.productcode, ISNULL(cd.srno,'') AS srno, cd.startdate, cd.enddate, a.ccode, a.modulecode
                                           FROM contractdetails cd JOIN amc a ON a.code = cd.contractcode
                                           WHERE a.module = 'SAL' AND a.amctype = " + warrType + " ORDER BY cd.code").Tables[0].Rows)
            {
                string k = Int(r["modulecode"]) + "|" + Str(r["srno"]) + "|" + Int(r["productcode"]);
                Queue<Det> q; if (!wDet.TryGetValue(k, out q)) wDet[k] = q = new Queue<Det>();
                q.Enqueue(new Det { Code = Int(r["code"]), Ccode = Int(r["ccode"]), Pcode = Int(r["productcode"]), Srno = Str(r["srno"]), Start = Date(r["startdate"]), End = Date(r["enddate"]) });
            }
            if (wDet.Count > 0)
            {
                Dictionary<string, object[]> salByKey = WarrantyContract.SalesOrderBySource(tgt);
                Dictionary<string, int> sItemByLine = new Dictionary<string, int>();
                foreach (DataRow r in GetSrc("SELECT nofficeid, ncode, nitem FROM trdsales1items WITH (NOLOCK) WHERE nofficeid IN (" + OfficeIn + ")").Tables[0].Rows)
                    sItemByLine[Int(r["nofficeid"]) + "|" + Int(r["ncode"])] = Int(r["nitem"]);
                Dictionary<string, Det> wBySrc = new Dictionary<string, Det>();
                foreach (DataRow r in GetSrc(@"SELECT nofficeid, nsales, nsales1, ncode, nitemserialno, vserialno
                                               FROM trdsales2itemsdet WITH (NOLOCK) WHERE nofficeid IN (" + OfficeIn + ") ORDER BY nofficeid, nsales, ncode").Tables[0].Rows)
                {
                    int office = Int(r["nofficeid"]);
                    object[] sal; if (!salByKey.TryGetValue(office + "|" + Int(r["nsales"]), out sal)) continue;
                    int item; if (!sItemByLine.TryGetValue(office + "|" + Int(r["nsales1"]), out item)) continue;
                    int pcode; if (!_prodByItem.TryGetValue(item, out pcode)) continue;
                    Queue<Det> dq; string dk = (int)sal[0] + "|" + Cap(Str(r["vserialno"]).Trim(), 50) + "|" + pcode;
                    if (!wDet.TryGetValue(dk, out dq) || dq.Count == 0) continue;
                    Det d = dq.Dequeue(); wLines++;
                    wBySrc[office + "|" + Int(r["ncode"])] = d;
                    string sk = NKey(r["nitemserialno"]); if (sk.Length == 0) continue;
                    List<Det> l; if (!_detBySerial.TryGetValue(sk, out l)) _detBySerial[sk] = l = new List<Det>();
                    if (!l.Any(x => x.Code == d.Code)) l.Add(d);
                }
                Dictionary<string, int> wk = new Dictionary<string, int>();
                foreach (DataRow r in GetSrc("SELECT nofficeid, nsales2, ncalls FROM trdsales7pmvisit WITH (NOLOCK) WHERE nofficeid IN (" + OfficeIn + ") ORDER BY nofficeid, nsales2, dschpmdate, ncode").Tables[0].Rows)
                {
                    int office = Int(r["nofficeid"]); string serialKey = office + "|" + Int(r["nsales2"]);
                    int k; wk.TryGetValue(serialKey, out k); wk[serialKey] = k + 1;     // 0-based index, as WarrantyContract numbered them
                    if (Int(r["ncalls"]) == 0) continue;
                    Det d; if (!wBySrc.TryGetValue(serialKey, out d)) continue;
                    int cc; if (!pmsByNo.TryGetValue("PMS" + d.Code.ToString("0000000") + "_" + k, out cc)) continue;
                    string ck = office + "|" + Int(r["ncalls"]);
                    if (_pmsByCall.ContainsKey(ck) || used.Contains(cc)) continue;
                    _pmsByCall[ck] = cc; used.Add(cc); wPm++;
                }
            }
            Console.WriteLine("  Warranty index: serial lines " + wLines + ", warranty PM rows matched to a call " + wPm);
            Console.WriteLine("  Contract index: serials " + _detBySerial.Count + ", PM rows matched to a call " + _pmsByCall.Count);
        }

