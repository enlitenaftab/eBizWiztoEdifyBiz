                using (SqlCommand ins = new SqlCommand("INSERT INTO miscellaneous (module, type, name, active, makedefault, createdby, createdon, updatedby, updatedon) VALUES ('Sales','Dispatch Mode', @n, 1, 0, @cb, GETDATE(), @cb, GETDATE())", tgt))
                { ins.Parameters.AddWithValue("@n", nm); ins.Parameters.AddWithValue("@cb", MigrationUser); ins.ExecuteNonQuery(); }
                have.Add(nm); added++;
            }
            Console.WriteLine("  Payment terms loaded: " + p + " rows across " + _payTermsByKey.Count + " sales; miscellaneous(Sales/Dispatch Mode) seeded: " + added);
        }

        // Post-tax charges in entry order (ncode). Label rows (TOTAL ..., amount/percent empty) come through with 0 and are skipped later.
