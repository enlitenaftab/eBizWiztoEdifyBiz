        static void InsertBill(SqlConnection tgt, DataRow h, int branch, string billno)
        {
            int office = Int(h["nofficeid"]); string key = office + "|" + Int(h["ncode"]);
            string callno = Str(h["vtrnno"]); if (callno.Length == 0) callno = (Str(h["vtrnprefix"]) + Str(h["ntrnno"])).Trim();
            object[] call; if (!_callByNo.TryGetValue(callno, out call)) { _noCall++; return; }
            decimal total = Dec(h["ntotalamount"]);
            object date = h["dinvoicedt"] != DBNull.Value ? h["dinvoicedt"] : P(h["dtrndate"]);
            object createdon = h["addedon"] != DBNull.Value ? h["addedon"] : date;
            object updatedon = h["editedon"] != DBNull.Value ? h["editedon"] : createdon;
            string trn = (Str(h["vtrnprefix"]) + Str(h["ntrnno"])).Trim();
            string rem = "Service Call: " + callno + (trn.Length > 0 ? " | Trn No: " + trn : "") + " (eBizWiz call bill) | eBizWiz Bill Amount: " + total.ToString("0.##", CultureInfo.InvariantCulture);

            using (SqlTransaction tx = tgt.BeginTransaction())
            {
                try
                {
                    int code;
                    using (SqlCommand c = new SqlCommand(@"INSERT INTO sal_order (salorderno, salorderdt, ccode, contactperson, executive, cbranchcode, currency, remarks, branchcode, comcode, [type], createdby, updatedby, createdon, updatedon)
                                                         OUTPUT INSERTED.code VALUES (@no, @dt, @cc, @cp, @ex, @bill, @cur, @rem, @br, @com, 'SO', @cb, @cb, @con, @uon)", tgt, tx))
                    {
                        c.Parameters.AddWithValue("@no", Cap(billno, 250));
                        c.Parameters.AddWithValue("@dt", date);
                        c.Parameters.AddWithValue("@cc", call[1]);
                        c.Parameters.AddWithValue("@cp", call[2]);
                        c.Parameters.AddWithValue("@ex", call[4] != DBNull.Value && Int(call[4]) > 0 ? call[4] : (object)MigrationUser);
                        c.Parameters.AddWithValue("@bill", call[3]);
                        c.Parameters.AddWithValue("@cur", _inr > 0 ? (object)_inr : DBNull.Value);
                        c.Parameters.AddWithValue("@rem", rem);
                        c.Parameters.AddWithValue("@br", branch);
                        c.Parameters.AddWithValue("@com", CompanyCode);
                        c.Parameters.AddWithValue("@cb", MigrationUser);
                        c.Parameters.AddWithValue("@con", createdon);
                        c.Parameters.AddWithValue("@uon", updatedon);
                        code = Convert.ToInt32(c.ExecuteScalar());
                    }
                    List<object[]> dets = new List<object[]>(); Dictionary<int, decimal> prodLineRate = new Dictionary<int, decimal>();
                    decimal itemsAll = 0m, lineTax = 0m; int lineN = 0, skip = 0;
                    List<object[]> parts; _parts.TryGetValue(key, out parts);
                    if (parts != null)
                        foreach (object[] p in parts)
                        {
                            decimal qty = (decimal)p[1], rate = (decimal)p[2];
                            itemsAll += qty * rate; lineTax += (decimal)p[4];
                            int pcode; if ((int)p[0] <= 0 || !_prodByItem.TryGetValue((int)p[0], out pcode)) { skip++; continue; }
                            int bt; object batch = _batchByProd.TryGetValue(pcode, out bt) ? (object)bt : DBNull.Value;
                            int det;
                            using (SqlCommand d = new SqlCommand(@"INSERT INTO sal_order_det (salcode, prodcode, prodbatchcode, qty, price, currency, warrantymonths, prod_desc, createdby, updatedby, createdon, updatedon)
                                                                 OUTPUT INSERTED.code VALUES (@sc, @p, @b, @q, @pr, @cur, 0, @pd, @cb, @cb, @con, @uon)", tgt, tx))
                            {
                                d.Parameters.AddWithValue("@sc", code);
                                d.Parameters.AddWithValue("@p", pcode);
                                d.Parameters.AddWithValue("@b", batch);
                                d.Parameters.AddWithValue("@q", qty);
                                d.Parameters.AddWithValue("@pr", rate == 0 ? (object)DBNull.Value : rate);
                                d.Parameters.AddWithValue("@cur", _inr > 0 ? (object)_inr : DBNull.Value);
                                d.Parameters.AddWithValue("@pd", PS((string)p[5]));
                                d.Parameters.AddWithValue("@cb", MigrationUser);
                                d.Parameters.AddWithValue("@con", createdon);
                                d.Parameters.AddWithValue("@uon", updatedon);
                                det = Convert.ToInt32(d.ExecuteScalar());
                            }
                            string pt; decimal val = (_prodType.TryGetValue(pcode, out pt) && pt == "s") ? rate : qty * rate;   // view line value, as for Sales Invoice
                            dets.Add(new object[] { det, pcode, val });
                            string tsn; decimal lr;
                            if ((int)p[3] > 0 && (decimal)p[4] != 0 && _taxsetName.TryGetValue((int)p[3], out tsn) && (lr = GstRateIn(tsn)) > 0 && !prodLineRate.ContainsKey(pcode)) prodLineRate[pcode] = lr;
                            lineN++;
                        }
                    List<object[]> ch; _charges.TryGetValue(key, out ch);
                    int[] ts = SalesInvoice.ApplyTaxFor(tgt, tx, code, "CALLBILL|" + key, call[3], dets, prodLineRate, itemsAll, lineTax, ch, createdon, updatedon);
                    int before = AmcBillInvoiceDiffCount();
                    int adj = ts[1] + AmcBillInvoice.BillDifference(tgt, tx, code, total, createdon, updatedon);
                    if (AmcBillInvoiceDiffCount() > before) _diff++;

                    using (SqlCommand l = new SqlCommand("INSERT INTO labelrelation (label, module, createdon, createdby) VALUES (@l, @m, @con, @cb)", tgt, tx))
                    { l.Parameters.AddWithValue("@l", _label); l.Parameters.AddWithValue("@m", code); l.Parameters.AddWithValue("@con", createdon); l.Parameters.AddWithValue("@cb", MigrationUser); l.ExecuteNonQuery(); }

                    tx.Commit();
                    _rows++; _lines += lineN; _skipLines += skip; _taxRows += ts[0]; _adjRows += adj; _total += total;
                }
                catch { tx.Rollback(); throw; }
            }
        }

        static int AmcBillInvoiceDiffCount() { return AmcBillInvoice.DiffCount; }
    }

