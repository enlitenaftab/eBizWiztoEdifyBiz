    // ==================================================================
    //  RECEIPT ENTRY : trhpayrg / trdpayrg1details  ->  payments / paymentdetails (+ companybank)
    //  One payments row per CHEQUE (eBizWiz keeps the cheque on the line, EdifyBiz on the header),
    //  inout = 0 (received) and paid = 1 so the money counts against invoices. SALES lines are
    //  allocated to the migrated Sales Invoice; AMC (contract schedule bill) and CALLS lines have no
    //  invoice in our app, so they are booked on account (modulecode NULL) and named in the remark.
    //  Mapping: Maping\13_payment_field_mapping.md. Run AFTER Sales Invoice / AMC Contract / Complaint. - Aftab Alam
    // ==================================================================
    static class Payment
    {
        //class Bill { public int Code; public string ContractNo, BillNo; public object Date; }
        class Bill { public int Code, Invoice; public string ContractNo, BillNo; public object Date; }   // Invoice = billingcycle.salcode (AmcBillInvoice) - Aftab Alam

        static Dictionary<int, string> _fixed, _officeName, _bankName;
        static readonly Dictionary<string, int> _custByParty = new Dictionary<string, int>();
        static readonly Dictionary<int, int> _branchByOffice = new Dictionary<int, int>();
        static readonly Dictionary<int, int> _bankByMst = new Dictionary<int, int>();          // mstbanks.ncode -> companybank.code
        static readonly Dictionary<string, int> _invBySrc = new Dictionary<string, int>();      // office|trhsales.ncode -> sal_order.code
        static readonly Dictionary<string, string> _invNo = new Dictionary<string, string>();   // office|trhsales.ncode -> SA..
        static readonly Dictionary<string, Bill> _billBySrc = new Dictionary<string, Bill>();   // office|trdcontr3bills.ncode -> billingcycle
        static readonly Dictionary<string, string> _callNo = new Dictionary<string, string>();  // office|trhcalls.ncode -> call no
        static readonly Dictionary<string, int> _callInvBySrc = new Dictionary<string, int>();  // office|trhcalls.ncode -> sal_order.code of its bill (CallBillInvoice) - Aftab Alam
        static int _allocAmcInv, _allocCallInv;
