                if (Int(r["nitem"]) <= 0) { _skipLines++; continue; }
                Add(_outLines, Int(r["nofficeid"]) + "|" + Int(r["nstkou"]), new object[] { Int(r["nitem"]), Dec(r["nquantity"]), Dec(r["ndefquantity"]), Dec(r["nrate"]), Int(r["nordrc1"]) });
