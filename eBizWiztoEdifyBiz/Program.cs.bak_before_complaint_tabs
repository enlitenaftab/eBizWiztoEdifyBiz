        static void BuildMaps(SqlConnection tgt)
        {
            foreach (DataRow r in GetTgt("SELECT code, name, sname FROM currency").Tables[0].Rows)
            {
                string nm = Str(r["name"]), sn = Str(r["sname"]);
                if (_inrCode == 0 && (sn.Equals("INR", StringComparison.OrdinalIgnoreCase) || nm.IndexOf("Indian Rupee", StringComparison.OrdinalIgnoreCase) >= 0)) _inrCode = Int(r["code"]);
            }
            foreach (int office in Offices)
            {
                string nm; string place = _officeName.TryGetValue(office, out nm) && nm.Length > 0 ? Cap(nm, 100) : "Office " + office;
                using (SqlCommand q = new SqlCommand("SELECT code FROM companyaddress WHERE ccode=@cc AND place=@pl", tgt))
                { q.Parameters.AddWithValue("@cc", CompanyCode); q.Parameters.AddWithValue("@pl", place); object o = q.ExecuteScalar(); if (o != null && o != DBNull.Value) _branchByOffice[office] = Convert.ToInt32(o); }
            }
            Dictionary<string, int> cByName = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
            foreach (DataRow r in GetTgt("SELECT code, name FROM contact WITH (NOLOCK) ORDER BY isdeleted").Tables[0].Rows) { string n = Str(r["name"]); if (n.Length > 0 && !cByName.ContainsKey(n)) cByName[n] = Int(r["code"]); }
            foreach (DataRow r in GetSrc("SELECT ncode, ntitle, vname FROM mstparty WITH (NOLOCK) WHERE nofficeid IN (" + OfficeIn + ")").Tables[0].Rows)
            {
                string k = NKey(r["ncode"]); if (k.Length == 0) continue;
                string nm = Cap(Join(LookInt(_fixed, Int(r["ntitle"])), Str(r["vname"])), 150);
                int c; if (nm.Length > 0 && cByName.TryGetValue(nm, out c) && !_custByParty.ContainsKey(k)) _custByParty[k] = c;
            }
            foreach (KeyValuePair<string, int> kv in PartyToContact) _custByParty[kv.Key] = kv.Value;
            foreach (DataRow r in GetTgt("SELECT code, ccode, isnull(isdefault,0) as isdefault FROM mltaddress WITH (NOLOCK) ORDER BY ccode, isdefault DESC, code").Tables[0].Rows)
            { int cc = Int(r["ccode"]); if (cc > 0 && !_branchByContact.ContainsKey(cc)) _branchByContact[cc] = Int(r["code"]); }
            Dictionary<string, int> pByName = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
            foreach (DataRow r in GetTgt("SELECT code, name FROM product WITH (NOLOCK) ORDER BY isdeleted").Tables[0].Rows) { string n = Str(r["name"]); if (n.Length > 0 && !pByName.ContainsKey(n)) pByName[n] = Int(r["code"]); }
            //foreach (DataRow r in GetSrc("SELECT ncode, vname FROM mstitems WITH (NOLOCK) WHERE nofficeid IN (" + OfficeIn + ")").Tables[0].Rows)
            //{ string n = Cap(Str(r["vname"]), 150); int c; if (n.Length > 0 && pByName.TryGetValue(n, out c) && !_prodByItem.ContainsKey(Int(r["ncode"]))) _prodByItem[Int(r["ncode"])] = c; }
            MapItemsToProducts(_prodByItem);   // Item Code + Name (not name only) - Aftab Alam

            // contact persons: same resolution as Customer Quotation (party|person -> mltcontact code)
            Dictionary<string, int> mltMap = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
            foreach (DataRow r in GetTgt("SELECT code, ccode, name FROM mltcontact WITH (NOLOCK)").Tables[0].Rows)
            { int code = Int(r["code"]), cc = Int(r["ccode"]); string name = Str(r["name"]); if (code > 0 && cc > 0 && name.Length > 0) { string k = cc + "|" + name; if (!mltMap.ContainsKey(k)) mltMap[k] = code; } }
            foreach (DataRow dr in GetSrc("SELECT nparty, ncode, ntitle, vcontactperson FROM msdparty WITH (NOLOCK) WHERE nofficeid IN (" + OfficeIn + ") AND LTRIM(RTRIM(ISNULL(vcontactperson,''))) <> ''").Tables[0].Rows)
            {
                string partyKey = NKey(dr["nparty"]); int personNo = Int(dr["ncode"]); if (partyKey.Length == 0 || personNo <= 0) continue;
                string key = partyKey + "|" + personNo; if (_persons.ContainsKey(key)) continue;
                string raw = Str(dr["vcontactperson"]); string formatted = Cap(Join(LookInt(_fixed, Int(dr["ntitle"])), raw), 150);
                string val = ""; int cc2, m1, m2;
                if (_custByParty.TryGetValue(partyKey, out cc2))
                {
                    if (mltMap.TryGetValue(cc2 + "|" + formatted, out m1)) val = m1.ToString();
                    else if (mltMap.TryGetValue(cc2 + "|" + raw, out m2)) val = m2.ToString();
                }
                _persons[key] = val;
            }
        }

        static string Join(string a, string b) { return string.Join(" ", new[] { a, b }.Where(s => !string.IsNullOrWhiteSpace(s))).Trim(); }
    }

    // ==================================================================
    //  AMC CONTRACT : trhcontr / trdcontr1items / trdcontr2itemsdet / trdcontr3bills / trdcontr7pmvisit
    //  -> amc / contractdetails (one per serial) / billingcycle / contractcall type 'PMS'.
    //  Quotation link amc.module='CQ' + modulecode (migrated AMC Quotation), renewal oldcontractcode + renew=1,
    //  amc.salcode never set (edit would delete that invoice), GST/charges in remarks (no tax on the standard contract).
    //  Mapping: Maping\11_amccontract_field_mapping.md. Run AFTER AMC Quotation. - Aftab Alam
    // ==================================================================
    static class AmcContract
    {
        static Dictionary<int, string> _fixed, _officeName, _payschedule, _termset, _checkset, _salesSource;
        static readonly Dictionary<string, int> _custByParty = new Dictionary<string, int>();
        static readonly Dictionary<int, int> _branchByContact = new Dictionary<int, int>();
        static readonly Dictionary<int, int> _prodByItem = new Dictionary<int, int>();
        static readonly Dictionary<int, int> _branchByOffice = new Dictionary<int, int>();
        static readonly Dictionary<string, int> _persons = new Dictionary<string, int>();                 // party|person -> mltcontact.code
        static readonly Dictionary<string, List<object[]>> _itemsByKey = new Dictionary<string, List<object[]>>();    // office|contr -> { line ncode, item, contractis, previousno }
        static readonly Dictionary<string, List<object[]>> _serialsByLine = new Dictionary<string, List<object[]>>(); // office|contr1 -> serial rows
        static readonly Dictionary<string, List<object[]>> _billsByKey = new Dictionary<string, List<object[]>>();
        static readonly Dictionary<string, List<object[]>> _visitsBySerial = new Dictionary<string, List<object[]>>(); // office|contr2 -> { sched, actual, calls }
        static readonly Dictionary<string, string> _quoteRef = new Dictionary<string, string>();   // office|trhoffer.ncode -> QA..
        static readonly Dictionary<string, int> _cqByKey = new Dictionary<string, int>();          // branch|QA.. -> inqcs.code
        static readonly Dictionary<string, string> _salesNo = new Dictionary<string, string>();    // office|trhsales.ncode -> SA..
        static readonly Dictionary<string, object> _salesDt = new Dictionary<string, object>();
        static readonly Dictionary<string, string> _contrNo = new Dictionary<string, string>();    // office|trhcontr.ncode -> MC..
        static readonly Dictionary<string, string> _callNo = new Dictionary<string, string>();     // office|trhcalls.ncode -> call no
        static readonly Dictionary<string, int> _amcBySrc = new Dictionary<string, int>();         // office|trhcontr.ncode -> amc.code
        static readonly List<int[]> _renewals = new List<int[]>();                                  // { new amc.code, office, previous trhcontr.ncode }
        static Dictionary<string, List<object[]>> _chargesByKey;
        static int _stOpen, _stClosed;
        static int _rows, _lines, _skipLines, _bills, _pms, _pmsClosed, _quoteLinked, _renewLinked, _errors;

        public static void Run()
        {
            Console.WriteLine("=====================================================");
            Console.WriteLine("   eBizWiz  ->  EdifyBiz   |   Module: AMC Contract (amc / contractdetails / billingcycle / PMS)");
            Console.WriteLine("   Offices in scope: " + OfficeIn + "  (fresh-DB direct insert)");
            Console.WriteLine("=====================================================");

            _fixed = SrcLookupInt("SELECT ncode, vdisplayvalue FROM mstfixedselection WITH (NOLOCK)");
            _officeName = SrcLookupInt("SELECT ncode, vcompanyname FROM mstoffice WITH (NOLOCK)");
            _payschedule = SrcLookupInt("SELECT ncode, vname FROM mstpaymentschedule WITH (NOLOCK)");
            _termset = SrcLookupInt("SELECT ncode, vname FROM msttermset WITH (NOLOCK)");
            _checkset = SrcLookupInt("SELECT ncode, vname FROM mstcheckset WITH (NOLOCK)");
            _salesSource = SrcLookupInt("SELECT ncode, vname FROM mstinquirysource WITH (NOLOCK)");

            using (SqlConnection tgt = OpenTgt())
            {
                BuildMaps(tgt);
                EnsureUserByCode();
                EnsureStatuses(tgt);
                LoadSource();
                _chargesByKey = LoadPostTaxCharges("trdcontr4posttaxchgs", "ncontr");
                Console.WriteLine("Maps: customers=" + _custByParty.Count + ", products=" + _prodByItem.Count + ", AMC quotations=" + _cqByKey.Count +
                                  ", status Open=" + _stOpen + " Closed=" + _stClosed);
                Console.WriteLine("-----------------------------------------------------");

                DataTable hdr = GetSrc(@"SELECT ncode, vtrnprefix, ntrnno, dtrndate, nparty, npartycontact, namcquoteno, nsalesman, vpono, dpodate, vrefno, drefdate,
                                               vremarks, vcomment, nitemtotal, ntotalamount, namountrecd, npaymentschedule, vbegorend, nterms, ncheckset, nsalessource, nofficeid, addedon, editedon
                                        FROM trhcontr WITH (NOLOCK) WHERE nofficeid IN (" + OfficeIn + ") ORDER BY ncode").Tables[0];
                foreach (DataRow h in hdr.Rows)
                {
                    try { InsertRow(tgt, h); }
                    catch (Exception ex) { _errors++; if (_errors <= 20) Console.WriteLine("  [ERROR] AMC Contract " + Int(h["nofficeid"]) + "|" + Int(h["ncode"]) + ": " + ex.Message); }
                }
                LinkRenewals(tgt);

                Console.WriteLine("-----------------------------------------------------");
                Console.WriteLine("  AMC Contracts migrated  : " + _rows + "  (quotation linked " + _quoteLinked + ", renewal linked " + _renewLinked + ")");
                Console.WriteLine("  contractdetails (serial): " + _lines + "  (skipped, item not migrated: " + _skipLines + ")");
                Console.WriteLine("  billingcycle            : " + _bills);
                Console.WriteLine("  PMS visits              : " + _pms + "  (closed " + _pmsClosed + ")");
                Console.WriteLine("  Errors                  : " + _errors);
                Console.WriteLine("-----------------------------------------------------");
            }
        }

        static void InsertRow(SqlConnection tgt, DataRow h)
        {
            int office = Int(h["nofficeid"]); int srcCode = Int(h["ncode"]); string key = office + "|" + srcCode;
            string contractno = (Str(h["vtrnprefix"]) + Str(h["ntrnno"])).Trim();
            string partyKey = NKey(h["nparty"]);
            object ccode = DBNull.Value, cbranch = DBNull.Value; int cid, br;
            if (partyKey.Length > 0 && _custByParty.TryGetValue(partyKey, out cid)) { ccode = cid; if (_branchByContact.TryGetValue(cid, out br)) cbranch = br; }
            int mlt; object contactperson = Int(h["npartycontact"]) > 0 && _persons.TryGetValue(partyKey + "|" + Int(h["npartycontact"]), out mlt) ? (object)mlt : DBNull.Value;
            int ex; object executive = UserByCode.TryGetValue(NKey(h["nsalesman"]), out ex) ? (object)ex : MigrationUser;
            int b; object branch = _branchByOffice.TryGetValue(office, out b) ? (object)b : DBNull.Value;
            object createdon = P(h["addedon"]);
            object updatedon = h["editedon"] != DBNull.Value ? h["editedon"] : createdon;

            // serial rows of the contract -> type (most serials), period, dates, item total
            List<object[]> items; _itemsByKey.TryGetValue(key, out items);
            int comp = 0, noncomp = 0; DateTime? start = null, end = null; decimal itemsAll = 0m; int months = 0;
            if (items != null)
                foreach (object[] it in items)
                {
                    List<object[]> srs; if (!_serialsByLine.TryGetValue(key + "|" + (int)it[0], out srs)) continue;
                    foreach (object[] s in srs)
                    {
                        string ct = LookInt(_fixed, (int)s[3]).ToUpperInvariant();
                        if (ct.Contains("NON-COMPREHENSIVE")) noncomp++; else if (ct.Contains("COMPREHENSIVE")) comp++;
                        DateTime? sd = s[6] as DateTime?, ed = s[7] as DateTime?;
                        if (sd.HasValue && (!start.HasValue || sd < start)) start = sd;
                        if (ed.HasValue && (!end.HasValue || ed > end)) end = ed;
                        if (months == 0 && (int)s[8] > 0) months = (int)s[8];
                        itemsAll += (decimal)s[4];
                    }
                }
            object amctype = comp + noncomp == 0 ? (object)DBNull.Value : (comp > noncomp ? "1" : "2");

            object module = DBNull.Value, modulecode = DBNull.Value; string qref; int cq;
            if (Int(h["namcquoteno"]) > 0 && _quoteRef.TryGetValue(office + "|" + Int(h["namcquoteno"]), out qref) && branch != DBNull.Value && _cqByKey.TryGetValue(b + "|" + qref, out cq))
            { module = "CQ"; modulecode = cq; }

            List<string> rem = new List<string>();
            string r1 = Str(h["vremarks"]); if (r1.Length > 0) rem.Add(r1);
            string cm = Str(h["vcomment"]); if (cm.Length > 0) rem.Add("Comment: " + cm);
            string rf = Str(h["vrefno"]); if (rf.Length > 0) rem.Add("Ref No: " + rf);
            if (h["drefdate"] != DBNull.Value) rem.Add("Ref Date: " + Dt(h["drefdate"]));
            if (Int(h["namcquoteno"]) > 0 && module == DBNull.Value && _quoteRef.TryGetValue(office + "|" + Int(h["namcquoteno"]), out qref)) rem.Add("AMC Quotation: " + qref);
            List<object[]> chg; decimal gstRate;
            if (_chargesByKey.TryGetValue(key, out chg))
            {
                List<object[]> rows = ComputeCharges(itemsAll, chg, out gstRate);
                if (rows.Count > 0) rem.Add("Charges (eBizWiz): " + string.Join("; ", rows.Select(a => (string)a[0] + " " + ((decimal)a[2]).ToString("0.##", CultureInfo.InvariantCulture))));
            }
            if (Dec(h["ntotalamount"]) != 0) rem.Add("eBizWiz Contract Total: " + Dec(h["ntotalamount"]).ToString("0.##", CultureInfo.InvariantCulture));
            if (Dec(h["namountrecd"]) != 0) rem.Add("Amount Received: " + Dec(h["namountrecd"]).ToString("0.##", CultureInfo.InvariantCulture));
            string ps = LookInt(_payschedule, Int(h["npaymentschedule"])); string be = BeginOrEnd(Str(h["vbegorend"]));   // form "B / E of Period"
            string tset = LookInt(_termset, Int(h["nterms"])); if (tset.Length > 0) rem.Add("Terms & Cond.: " + tset);
            //string cset = LookInt(_checkset, Int(h["ncheckset"])); if (cset.Length > 0) rem.Add("Check List: " + cset);   // check set -> Checklist Master; items are in the Task Check List tab, not in the remark - Aftab Alam
            // Sales Source (mstinquirysource; 1 contract) - no source field on the AMC contract. - Aftab Alam
            string ssrc = LookInt(_salesSource, Int(h["nsalessource"])); if (ssrc.Length > 0) rem.Add("Sales Source: " + ssrc);

            using (SqlTransaction tx = tgt.BeginTransaction())
            {
                try
                {
                    int code;
                    using (SqlCommand c = new SqlCommand(@"INSERT INTO amc (ccode, contractno, contractdate, startdate, enddate, amctype, executive, renew, branch, ponum, podate,
                                                                            contractyears, contractmonths, remarks, contactperson, module, modulecode, paymentterms, contactbranch,
                                                                            createdby, createdon, updatedby, updatedon)
                                                         OUTPUT INSERTED.code
                                                         VALUES (@cc, @no, @dt, @sd, @ed, @type, @ex, 0, @br, @po, @podt, @yr, @mo, @rem, @cp, @mod, @mc, @pt, @cbr, @cb, @con, @cb, @uon)", tgt, tx))
                    {
                        c.Parameters.AddWithValue("@cc", ccode);
                        c.Parameters.AddWithValue("@no", PS(contractno));
                        c.Parameters.AddWithValue("@dt", P(h["dtrndate"]));
                        c.Parameters.AddWithValue("@sd", start.HasValue ? (object)start.Value : DBNull.Value);
                        c.Parameters.AddWithValue("@ed", end.HasValue ? (object)end.Value : DBNull.Value);
                        c.Parameters.AddWithValue("@type", amctype);
                        c.Parameters.AddWithValue("@ex", executive);
                        c.Parameters.AddWithValue("@br", branch);
                        c.Parameters.AddWithValue("@po", PS(Cap(Str(h["vpono"]), 250)));
                        c.Parameters.AddWithValue("@podt", P(h["dpodate"]));
                        c.Parameters.AddWithValue("@yr", months / 12);
                        c.Parameters.AddWithValue("@mo", months % 12);
                        c.Parameters.AddWithValue("@rem", PS(string.Join(" | ", rem)));
                        c.Parameters.AddWithValue("@cp", contactperson);
                        c.Parameters.AddWithValue("@mod", module);
                        c.Parameters.AddWithValue("@mc", modulecode);
                        c.Parameters.AddWithValue("@pt", PS(ps.Length > 0 ? ps + (be.Length > 0 ? " - " + be : "") : ""));
                        c.Parameters.AddWithValue("@cbr", cbranch);
                        c.Parameters.AddWithValue("@cb", MigrationUser);
                        c.Parameters.AddWithValue("@con", createdon);
                        c.Parameters.AddWithValue("@uon", updatedon);
                        code = Convert.ToInt32(c.ExecuteScalar());
                    }

                    int lineN = 0, pmsN = 0, pmsClosedN = 0; List<int> prevContracts = new List<int>();
                    if (items != null)
                        foreach (object[] it in items)
                        {
                            string contractis = LookInt(_fixed, (int)it[2]);
                            if ((int)it[3] > 0 && contractis.IndexOf("FROM CONTRACT", StringComparison.OrdinalIgnoreCase) >= 0 && !prevContracts.Contains((int)it[3])) prevContracts.Add((int)it[3]);
                            string prevNo; string prevText = (int)it[3] > 0 && contractis.IndexOf("FROM CONTRACT", StringComparison.OrdinalIgnoreCase) >= 0 ? "Previous Contract: " + (_contrNo.TryGetValue(office + "|" + (int)it[3], out prevNo) ? prevNo : "#" + (int)it[3]) : "";
                            object invNo = DBNull.Value, invDt = DBNull.Value; string sno;
                            if ((int)it[3] > 0 && contractis.IndexOf("FROM WARRANTY", StringComparison.OrdinalIgnoreCase) >= 0 && _salesNo.TryGetValue(office + "|" + (int)it[3], out sno))
                            { invNo = Cap(sno, 50); invDt = _salesDt[office + "|" + (int)it[3]]; }
                            List<object[]> srs; if (!_serialsByLine.TryGetValue(key + "|" + (int)it[0], out srs)) continue;
                            int pcode;
                            if (!_prodByItem.TryGetValue((int)it[1], out pcode)) { _skipLines += srs.Count; continue; }
                            foreach (object[] s in srs)
                            {
                                int months1 = (int)s[8], pm = (int)s[9];
                                object intervals = DBNull.Value;
                                if (months1 > 0 && (pm * 12) % months1 == 0) { int py = pm * 12 / months1; if (py == 0 || py == 1 || py == 2 || py == 3 || py == 4 || py == 6 || py == 12) intervals = py; }
                                List<string> lr = new List<string>();
                                string ct = LookInt(_fixed, (int)s[3]); if (ct.Length > 0) lr.Add("Contract Type: " + ct);
                                if (months1 > 0) lr.Add("Months: " + months1);
                                lr.Add("PM Visits: " + pm);
                                if (contractis.Length > 0) lr.Add(contractis);
                                if (prevText.Length > 0) lr.Add(prevText);
                                if ((decimal)s[5] != 0) lr.Add("Master Rate: " + ((decimal)s[10]).ToString("0.##", CultureInfo.InvariantCulture) + ", Discount %: " + ((decimal)s[5]).ToString("0.##", CultureInfo.InvariantCulture));
                                if ((bool)s[11]) lr.Add("Closed");
                                int det;
                                using (SqlCommand d = new SqlCommand(@"INSERT INTO contractdetails (contractcode, productcode, srno, invoiceno, invoicedate, installationdate, intervals, amount, location, startdate, enddate, iscomponent, remark, quantity, createdby, createdon, updatedby, updatedon)
                                                                     OUTPUT INSERTED.code
                                                                     VALUES (@c, @p, @sr, @inv, @invdt, @inst, @int, @amt, @loc, @sd, @ed, 0, @rem, 1, @cb, @con, @cb, @uon)", tgt, tx))
                                {
                                    d.Parameters.AddWithValue("@c", code);
                                    d.Parameters.AddWithValue("@p", pcode);
                                    d.Parameters.AddWithValue("@sr", PS(Cap((string)s[1], 50)));
                                    d.Parameters.AddWithValue("@inv", invNo);
                                    d.Parameters.AddWithValue("@invdt", invDt);
                                    d.Parameters.AddWithValue("@inst", s[12]);
                                    d.Parameters.AddWithValue("@int", intervals);
                                    d.Parameters.AddWithValue("@amt", (decimal)s[4]);
                                    d.Parameters.AddWithValue("@loc", PS((string)s[2]));
                                    d.Parameters.AddWithValue("@sd", s[6] ?? DBNull.Value);
                                    d.Parameters.AddWithValue("@ed", s[7] ?? DBNull.Value);
                                    d.Parameters.AddWithValue("@rem", PS(string.Join(" | ", lr)));
                                    d.Parameters.AddWithValue("@cb", MigrationUser);
                                    d.Parameters.AddWithValue("@con", createdon);
                                    d.Parameters.AddWithValue("@uon", updatedon);
                                    det = Convert.ToInt32(d.ExecuteScalar());
                                }
                                lineN++;

                                // PM visits of this serial -> contractcall PMS (real schedule / done dates)
                                List<object[]> vs;
                                if (_visitsBySerial.TryGetValue(office + "|" + (int)s[0], out vs))
                                {
                                    int k = 0;
                                    foreach (object[] v in vs)
                                    {
                                        bool done = v[1] != DBNull.Value;
                                        string cn; string callRemark = (int)v[2] > 0 ? "Call: " + (_callNo.TryGetValue(office + "|" + (int)v[2], out cn) ? cn : "#" + (int)v[2]) : null;
                                        using (SqlCommand q = new SqlCommand(@"INSERT INTO contractcall (contractdtcode, date, complaintdate, status, type, pmscomplaintno, ccode, productcode, serialno, closedt, remark, contactperson, createdby, createdon, updatedby, updatedon)
                                                                             VALUES (@dc, @dt, @dt, @st, 'PMS', @no, @cc, @p, @sr, @cl, @rem, @cp, @cb, @con, @cb, @uon)", tgt, tx))
                                        {
                                            q.Parameters.AddWithValue("@dc", det);
                                            q.Parameters.AddWithValue("@dt", v[0]);
                                            q.Parameters.AddWithValue("@st", done ? _stClosed : _stOpen);
                                            q.Parameters.AddWithValue("@no", "PMS" + det.ToString("0000000") + "_" + k);
                                            q.Parameters.AddWithValue("@cc", ccode);
                                            q.Parameters.AddWithValue("@p", pcode);
                                            q.Parameters.AddWithValue("@sr", PS(Cap((string)s[1], 50)));
                                            q.Parameters.AddWithValue("@cl", v[1]);
                                            q.Parameters.AddWithValue("@rem", PS(callRemark));
                                            q.Parameters.AddWithValue("@cp", contactperson);
                                            q.Parameters.AddWithValue("@cb", MigrationUser);
                                            q.Parameters.AddWithValue("@con", createdon);
                                            q.Parameters.AddWithValue("@uon", done ? v[1] : updatedon);
                                            q.ExecuteNonQuery();
                                        }
                                        k++; pmsN++; if (done) pmsClosedN++;
                                    }
                                }
                            }
                        }

                    int billN = 0;
                    List<object[]> bills;
                    if (_billsByKey.TryGetValue(key, out bills))
                    {
                        string billPrefix = "BILL_" + ("0000000000" + contractno).Substring(("0000000000" + contractno).Length - 10);
                        foreach (object[] bl in bills)
                        {
                            using (SqlCommand q = new SqlCommand("INSERT INTO billingcycle (amccode, billingno, billingdate, amount, type, createdby, createdon, updatedby, updatedon) VALUES (@a, @no, @dt, @amt, 'BILL', @cb, @con, @cb, @uon)", tgt, tx))
                            {
                                q.Parameters.AddWithValue("@a", code);
                                q.Parameters.AddWithValue("@no", billPrefix + "_" + (billN + 1));
                                q.Parameters.AddWithValue("@dt", bl[0]);
                                q.Parameters.AddWithValue("@amt", bl[1]);
                                q.Parameters.AddWithValue("@cb", MigrationUser);
                                q.Parameters.AddWithValue("@con", createdon);
                                q.Parameters.AddWithValue("@uon", updatedon);
                                q.ExecuteNonQuery();
                            }
                            billN++;
                        }
                    }

                    tx.Commit();
                    _amcBySrc[key] = code;
                    for (int pi = 0; pi < prevContracts.Count; pi++) _renewals.Add(new[] { code, office, prevContracts[pi], pi == 0 ? 1 : 0 });
                    _rows++; _lines += lineN; _pms += pmsN; _pmsClosed += pmsClosedN; _bills += billN; if (modulecode != DBNull.Value) _quoteLinked++;
                    if (_rows % 1000 == 0) Console.WriteLine("  ... " + _rows + " AMC Contracts migrated");
                }
                catch { tx.Rollback(); throw; }
            }
        }

        // Renewal: every previous contract of a renewed contract gets renew = 1 (296 eBizWiz contracts merge several old ones);
        // oldcontractcode (one column) = the first previous contract found; each line's remark names its own previous contract.
        // A contract pointing to itself (10 in eBizWiz) is ignored. - Aftab Alam
        static void LinkRenewals(SqlConnection tgt)
        {
            HashSet<int> linked = new HashSet<int>();
            foreach (int[] r in _renewals)
            {
                int old; if (!_amcBySrc.TryGetValue(r[1] + "|" + r[2], out old) || old == r[0]) continue;
                using (SqlCommand u = new SqlCommand("UPDATE amc SET renew=1 WHERE code=@old", tgt)) { u.Parameters.AddWithValue("@old", old); u.ExecuteNonQuery(); }
                if (!linked.Contains(r[0]))
                {
                    using (SqlCommand u = new SqlCommand("UPDATE amc SET oldcontractcode=@old WHERE code=@new", tgt))
                    { u.Parameters.AddWithValue("@old", old); u.Parameters.AddWithValue("@new", r[0]); u.ExecuteNonQuery(); }
                    linked.Add(r[0]); _renewLinked++;
                }
            }
        }

        // status module 'AMC': the app looks up name 'Open' (new PMS/complaint) and behavior 'Completed' (close) — same as the Cona reference.
        static void EnsureStatuses(SqlConnection tgt)
        {
            _stOpen = AmcStatus(tgt, "Open", "Pending", 1);
            _stClosed = AmcStatus(tgt, "Closed", "Completed", 0);
        }

        static int AmcStatus(SqlConnection tgt, string name, string behavior, int makedefault)
        {
            using (SqlCommand q = new SqlCommand("SELECT TOP 1 code FROM status WHERE module='AMC' AND name=@n ORDER BY code", tgt))
            { q.Parameters.AddWithValue("@n", name); object o = q.ExecuteScalar(); if (o != null && o != DBNull.Value) return Convert.ToInt32(o); }
            using (SqlCommand ins = new SqlCommand("INSERT INTO status (name, module, behavior, sort, makedefault, createdby, createdon, updatedby, updatedon) OUTPUT INSERTED.code VALUES (@n, 'AMC', @b, 0, @d, @cb, GETDATE(), @cb, GETDATE())", tgt))
            {
                ins.Parameters.AddWithValue("@n", name); ins.Parameters.AddWithValue("@b", behavior); ins.Parameters.AddWithValue("@d", makedefault); ins.Parameters.AddWithValue("@cb", MigrationUser);
                return Convert.ToInt32(ins.ExecuteScalar());
            }
        }

        static string Dt(object v) { return v == DBNull.Value || v == null ? "" : Convert.ToDateTime(v).ToString("dd/MM/yyyy", CultureInfo.InvariantCulture); }

        static void LoadSource()
        {
            // Product lines by line code. A serial belongs to the contract in its OWN ncontr (eBizWiz header item total follows
            // trdcontr2itemsdet.ncontr; 20 serial rows point to a product line of another contract) - product / sign-up info from its line.
            Dictionary<string, object[]> itemByLine = new Dictionary<string, object[]>();
            foreach (DataRow r in GetSrc("SELECT nofficeid, ncontr, ncode, nitem, ncontractis, npreviousno FROM trdcontr1items WITH (NOLOCK) WHERE nofficeid IN (" + OfficeIn + ")").Tables[0].Rows)
                itemByLine[Int(r["nofficeid"]) + "|" + Int(r["ncode"])] = new object[] { Int(r["ncode"]), Int(r["nitem"]), Int(r["ncontractis"]), Int(r["npreviousno"]) };
            foreach (DataRow r in GetSrc("SELECT nofficeid, ncode, vtrnprefix, ntrnno FROM trhcontr WITH (NOLOCK) WHERE nofficeid IN (" + OfficeIn + ")").Tables[0].Rows)
                _contrNo[Int(r["nofficeid"]) + "|" + Int(r["ncode"])] = (Str(r["vtrnprefix"]) + Str(r["ntrnno"])).Trim();
            // { 0 ncode, 1 serial, 2 location, 3 contrtype, 4 rate, 5 discpct, 6 start, 7 end, 8 months, 9 pmvisits, 10 masterrate, 11 closed, 12 first install }
            foreach (DataRow r in GetSrc(@"SELECT nofficeid, ncontr, ncontr1, ncode, vserialno, vlocation, ncontrtype, nrate, ndiscountperc, dstartdate, denddate, nmonths, npmvisits, nmasterrate, bclosed, dfirstinstdate
                                           FROM trdcontr2itemsdet WITH (NOLOCK) WHERE nofficeid IN (" + OfficeIn + ") ORDER BY nofficeid, ncontr, ncontr1, ncode").Tables[0].Rows)
            {
                object[] line; string ck = Int(r["nofficeid"]) + "|" + Int(r["ncontr"]);
                if (!itemByLine.TryGetValue(Int(r["nofficeid"]) + "|" + Int(r["ncontr1"]), out line)) { _skipLines++; continue; }   // 1 orphan serial row in eBizWiz
                List<object[]> li; if (!_itemsByKey.TryGetValue(ck, out li)) _itemsByKey[ck] = li = new List<object[]>();
                if (!li.Any(x => (int)x[0] == (int)line[0])) li.Add(line);
                string k = ck + "|" + Int(r["ncontr1"]);
                List<object[]> l; if (!_serialsByLine.TryGetValue(k, out l)) _serialsByLine[k] = l = new List<object[]>();
                l.Add(new object[] { Int(r["ncode"]), Str(r["vserialno"]), Str(r["vlocation"]), Int(r["ncontrtype"]), Dec(r["nrate"]), Dec(r["ndiscountperc"]),
                                     r["dstartdate"] == DBNull.Value ? null : (object)Convert.ToDateTime(r["dstartdate"]), r["denddate"] == DBNull.Value ? null : (object)Convert.ToDateTime(r["denddate"]),
                                     Int(r["nmonths"]), Int(r["npmvisits"]), Dec(r["nmasterrate"]), Bool(r["bclosed"]), P(r["dfirstinstdate"]) });
            }
            foreach (DataRow r in GetSrc("SELECT nofficeid, ncontr, dbilldate, nbillamount FROM trdcontr3bills WITH (NOLOCK) WHERE nofficeid IN (" + OfficeIn + ") ORDER BY nofficeid, ncontr, dbilldate, ncode").Tables[0].Rows)
            {
                string k = Int(r["nofficeid"]) + "|" + Int(r["ncontr"]);
                List<object[]> l; if (!_billsByKey.TryGetValue(k, out l)) _billsByKey[k] = l = new List<object[]>();
                l.Add(new object[] { P(r["dbilldate"]), Dec(r["nbillamount"]) });
            }
            foreach (DataRow r in GetSrc("SELECT nofficeid, ncontr2, dschpmdate, dactpmdate, ncalls FROM trdcontr7pmvisit WITH (NOLOCK) WHERE nofficeid IN (" + OfficeIn + ") ORDER BY nofficeid, ncontr2, dschpmdate, ncode").Tables[0].Rows)
            {
                string k = Int(r["nofficeid"]) + "|" + Int(r["ncontr2"]);
                List<object[]> l; if (!_visitsBySerial.TryGetValue(k, out l)) _visitsBySerial[k] = l = new List<object[]>();
                l.Add(new object[] { P(r["dschpmdate"]), P(r["dactpmdate"]), Int(r["ncalls"]) });
            }
            foreach (DataRow r in GetSrc("SELECT nofficeid, ncode, vtrnprefix, ntrnno FROM trhoffer WITH (NOLOCK) WHERE nofficeid IN (" + OfficeIn + ")").Tables[0].Rows)
                _quoteRef[Int(r["nofficeid"]) + "|" + Int(r["ncode"])] = (Str(r["vtrnprefix"]) + Str(r["ntrnno"])).Trim();
            foreach (DataRow r in GetSrc("SELECT nofficeid, ncode, vtrnprefix, ntrnno, dtrndate FROM trhsales WITH (NOLOCK) WHERE nofficeid IN (" + OfficeIn + ")").Tables[0].Rows)
            {
                string k = Int(r["nofficeid"]) + "|" + Int(r["ncode"]);
                _salesNo[k] = (Str(r["vtrnprefix"]) + Str(r["ntrnno"])).Trim(); _salesDt[k] = P(r["dtrndate"]);
            }
            foreach (DataRow r in GetSrc("SELECT nofficeid, ncode, vtrnprefix, ntrnno FROM trhcalls WITH (NOLOCK) WHERE nofficeid IN (" + OfficeIn + ")").Tables[0].Rows)
                _callNo[Int(r["nofficeid"]) + "|" + Int(r["ncode"])] = (Str(r["vtrnprefix"]) + Str(r["ntrnno"])).Trim();
            Console.WriteLine("  Source: contracts with lines " + _itemsByKey.Count + ", serial groups " + _serialsByLine.Count + ", bill groups " + _billsByKey.Count + ", PM visit groups " + _visitsBySerial.Count);
        }

        static void BuildMaps(SqlConnection tgt)
        {
            foreach (int office in Offices)
            {
                string nm; string place = _officeName.TryGetValue(office, out nm) && nm.Length > 0 ? Cap(nm, 100) : "Office " + office;
                using (SqlCommand q = new SqlCommand("SELECT code FROM companyaddress WHERE ccode=@cc AND place=@pl", tgt))
                { q.Parameters.AddWithValue("@cc", CompanyCode); q.Parameters.AddWithValue("@pl", place); object o = q.ExecuteScalar(); if (o != null && o != DBNull.Value) _branchByOffice[office] = Convert.ToInt32(o); }
            }
            Dictionary<string, int> cByName = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
            foreach (DataRow r in GetTgt("SELECT code, name FROM contact WITH (NOLOCK) ORDER BY isdeleted").Tables[0].Rows) { string n = Str(r["name"]); if (n.Length > 0 && !cByName.ContainsKey(n)) cByName[n] = Int(r["code"]); }
            foreach (DataRow r in GetSrc("SELECT ncode, ntitle, vname FROM mstparty WITH (NOLOCK) WHERE nofficeid IN (" + OfficeIn + ")").Tables[0].Rows)
            {
                string k = NKey(r["ncode"]); if (k.Length == 0) continue;
                string nm = Cap(Join(LookInt(_fixed, Int(r["ntitle"])), Str(r["vname"])), 150);
                int c; if (nm.Length > 0 && cByName.TryGetValue(nm, out c) && !_custByParty.ContainsKey(k)) _custByParty[k] = c;
            }
            foreach (KeyValuePair<string, int> kv in PartyToContact) _custByParty[kv.Key] = kv.Value;
            foreach (DataRow r in GetTgt("SELECT code, ccode, isnull(isdefault,0) as isdefault FROM mltaddress WITH (NOLOCK) ORDER BY ccode, isdefault DESC, code").Tables[0].Rows)
            { int cc = Int(r["ccode"]); if (cc > 0 && !_branchByContact.ContainsKey(cc)) _branchByContact[cc] = Int(r["code"]); }
            Dictionary<string, int> pByName = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
            foreach (DataRow r in GetTgt("SELECT code, name FROM product WITH (NOLOCK) ORDER BY isdeleted").Tables[0].Rows) { string n = Str(r["name"]); if (n.Length > 0 && !pByName.ContainsKey(n)) pByName[n] = Int(r["code"]); }
            //foreach (DataRow r in GetSrc("SELECT ncode, vname FROM mstitems WITH (NOLOCK) WHERE nofficeid IN (" + OfficeIn + ")").Tables[0].Rows)
            //{ string n = Cap(Str(r["vname"]), 150); int c; if (n.Length > 0 && pByName.TryGetValue(n, out c) && !_prodByItem.ContainsKey(Int(r["ncode"]))) _prodByItem[Int(r["ncode"])] = c; }
            MapItemsToProducts(_prodByItem);   // Item Code + Name (not name only) - Aftab Alam
            // AMC quotations migrated by module 9 (cors CQ, modulename 'AMC Contract')
            foreach (DataRow r in GetTgt("SELECT code, branchcode, inqref FROM inqcs WHERE cors='CQ' AND modulename='AMC Contract' AND inqref IS NOT NULL").Tables[0].Rows)
            { string k = Int(r["branchcode"]) + "|" + Str(r["inqref"]); if (!_cqByKey.ContainsKey(k)) _cqByKey[k] = Int(r["code"]); }
            // contact persons (party|person -> mltcontact.code), same resolution as the quotation modules
            Dictionary<string, int> mltMap = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
            foreach (DataRow r in GetTgt("SELECT code, ccode, name FROM mltcontact WITH (NOLOCK)").Tables[0].Rows)
            { int code = Int(r["code"]), cc = Int(r["ccode"]); string name = Str(r["name"]); if (code > 0 && cc > 0 && name.Length > 0) { string k = cc + "|" + name; if (!mltMap.ContainsKey(k)) mltMap[k] = code; } }
            foreach (DataRow dr in GetSrc("SELECT nparty, ncode, ntitle, vcontactperson FROM msdparty WITH (NOLOCK) WHERE nofficeid IN (" + OfficeIn + ") AND LTRIM(RTRIM(ISNULL(vcontactperson,''))) <> ''").Tables[0].Rows)
            {
                string partyKey = NKey(dr["nparty"]); int personNo = Int(dr["ncode"]); if (partyKey.Length == 0 || personNo <= 0) continue;
                string key = partyKey + "|" + personNo; if (_persons.ContainsKey(key)) continue;
                string raw = Str(dr["vcontactperson"]); string formatted = Cap(Join(LookInt(_fixed, Int(dr["ntitle"])), raw), 150);
                int cc2, m1, m2;
                if (_custByParty.TryGetValue(partyKey, out cc2))
                {
                    if (mltMap.TryGetValue(cc2 + "|" + formatted, out m1)) _persons[key] = m1;
                    else if (mltMap.TryGetValue(cc2 + "|" + raw, out m2)) _persons[key] = m2;
                }
            }
        }

        static string Join(string a, string b) { return string.Join(" ", new[] { a, b }.Where(s => !string.IsNullOrWhiteSpace(s))).Trim(); }
    }

    // ==================================================================
    //  WARRANTY CONTRACT (part of module 10): the warranty of every serial sold on a Sales Invoice, and its PM visit schedule.
    //  EdifyBiz standard (checked in amc/app/contract.aspx.cs): a warranty is an AMC contract of type 'Warranty' (amctype),
    //  linked to the invoice with amc.module='SAL' + modulecode = sal_order.code (listed under "AMC Contracts" on the invoice view),
    //  one contractdetails row per serial, one contractcall 'PMS' row per PM visit (Open / Closed, number "PMS"+7-digit line+"_"+k,
    //  same as module 10). Source: trhsales / trdsales2itemsdet / trdsales7pmvisit. Header values come from the migrated
    //  sal_order (customer, contact, executive, Bill To, branch) so the contract matches the invoice. Module 11 links the calls. - Aftab Alam
    // ==================================================================
    static class WarrantyContract
    {
        static readonly Dictionary<int, int> _prodByItem = new Dictionary<int, int>();
        static int _stOpen, _stClosed, _typeWarranty;
        static int _rows, _lines, _skipLines, _pms, _pmsClosed, _noInvoice, _errors;

        public static void Run()
        {
            Console.WriteLine("   -- Warranty contracts (sold serials -> amc type Warranty / contractdetails / PMS) --");
            using (SqlConnection tgt = OpenTgt())
            {
                _stOpen = StatusCode(tgt, "Open"); _stClosed = StatusCode(tgt, "Closed");
                _typeWarranty = WarrantyType(tgt);
                BuildProductMap(tgt);
                Dictionary<string, object[]> salByKey = SalesOrderBySource(tgt);   // office|trhsales.ncode -> sal_order row

                Dictionary<string, int> itemByLine = new Dictionary<string, int>();
                foreach (DataRow r in GetSrc("SELECT nofficeid, ncode, nitem FROM trdsales1items WITH (NOLOCK) WHERE nofficeid IN (" + OfficeIn + ")").Tables[0].Rows)
                    itemByLine[Int(r["nofficeid"]) + "|" + Int(r["ncode"])] = Int(r["nitem"]);

                // PM visits per serial, in the order module 11 counts them (nofficeid, nsales2, dschpmdate, ncode)
                Dictionary<string, List<object[]>> visits = new Dictionary<string, List<object[]>>();
                Dictionary<string, string> callNo = new Dictionary<string, string>();
                foreach (DataRow r in GetSrc("SELECT nofficeid, ncode, vtrnprefix, ntrnno, vtrnno FROM trhcalls WITH (NOLOCK) WHERE nofficeid IN (" + OfficeIn + ")").Tables[0].Rows)
                { string cn = Str(r["vtrnno"]); if (cn.Length == 0) cn = (Str(r["vtrnprefix"]) + Str(r["ntrnno"])).Trim(); callNo[Int(r["nofficeid"]) + "|" + Int(r["ncode"])] = cn; }
                foreach (DataRow r in GetSrc("SELECT nofficeid, nsales2, dschpmdate, dactpmdate, ncalls FROM trdsales7pmvisit WITH (NOLOCK) WHERE nofficeid IN (" + OfficeIn + ") ORDER BY nofficeid, nsales2, dschpmdate, ncode").Tables[0].Rows)
                {
                    string k = Int(r["nofficeid"]) + "|" + Int(r["nsales2"]);
                    List<object[]> l; if (!visits.TryGetValue(k, out l)) visits[k] = l = new List<object[]>();
                    l.Add(new object[] { P(r["dschpmdate"]), P(r["dactpmdate"]), Int(r["ncalls"]) });
                }

                // serial rows per invoice, in (nofficeid, nsales, ncode) order - the same order module 11 re-reads them
                Dictionary<string, List<DataRow>> serialsBySale = new Dictionary<string, List<DataRow>>();
                List<string> saleOrder = new List<string>();
                foreach (DataRow r in GetSrc(@"SELECT nofficeid, nsales, nsales1, ncode, vserialno, dstartdate, denddate, nmonths, npmvisits, dinstdate, vlocation, bclosed
                                               FROM trdsales2itemsdet WITH (NOLOCK) WHERE nofficeid IN (" + OfficeIn + ") ORDER BY nofficeid, nsales, ncode").Tables[0].Rows)
                {
                    string k = Int(r["nofficeid"]) + "|" + Int(r["nsales"]);
                    List<DataRow> l; if (!serialsBySale.TryGetValue(k, out l)) { serialsBySale[k] = l = new List<DataRow>(); saleOrder.Add(k); }
                    l.Add(r);
                }

                foreach (string sk in saleOrder)
                {
                    try { InsertContract(tgt, sk, serialsBySale[sk], salByKey, itemByLine, visits, callNo); }
                    catch (Exception ex) { _errors++; if (_errors <= 20) Console.WriteLine("  [ERROR] Warranty " + sk + ": " + ex.Message); }
                }
            }
            Console.WriteLine("  Warranty contracts      : " + _rows + "  (invoice not migrated: " + _noInvoice + ")");
            Console.WriteLine("  contractdetails (serial): " + _lines + "  (skipped, item not migrated: " + _skipLines + ")");
            Console.WriteLine("  PMS visits              : " + _pms + "  (closed " + _pmsClosed + ")");
            Console.WriteLine("  Errors                  : " + _errors);
            Console.WriteLine("-----------------------------------------------------");
        }

        static void InsertContract(SqlConnection tgt, string saleKey, List<DataRow> serials, Dictionary<string, object[]> salByKey,
                                   Dictionary<string, int> itemByLine, Dictionary<string, List<object[]>> visits, Dictionary<string, string> callNo)
        {
            object[] sal; if (!salByKey.TryGetValue(saleKey, out sal)) { _noInvoice++; return; }
            // sal = { 0 code, 1 salorderno, 2 salorderdt, 3 ccode, 4 contactperson, 5 executive, 6 cbranchcode, 7 branchcode, 8 createdon, 9 updatedon }
            int office = Convert.ToInt32(saleKey.Split('|')[0]);
            DateTime? start = null, end = null; int months = 0;
            foreach (DataRow s in serials)
            {
                DateTime? sd = Date(s["dstartdate"]), ed = Date(s["denddate"]);
                if (sd.HasValue && (!start.HasValue || sd < start)) start = sd;
                if (ed.HasValue && (!end.HasValue || ed > end)) end = ed;
                if (months == 0 && Int(s["nmonths"]) > 0) months = Int(s["nmonths"]);
            }
            using (SqlTransaction tx = tgt.BeginTransaction())
            {
                try
                {
                    int code;
                    using (SqlCommand c = new SqlCommand(@"INSERT INTO amc (ccode, contractno, contractdate, startdate, enddate, amctype, executive, renew, branch,
                                                                            contractyears, contractmonths, remarks, contactperson, module, modulecode, contactbranch,
                                                                            createdby, createdon, updatedby, updatedon)
                                                         OUTPUT INSERTED.code
                                                         VALUES (@cc, @no, @dt, @sd, @ed, @type, @ex, 0, @br, @yr, @mo, @rem, @cp, 'SAL', @mc, @cbr, @cb, @con, @cb, @uon)", tgt, tx))
                    {
                        c.Parameters.AddWithValue("@cc", sal[3]);
                        c.Parameters.AddWithValue("@no", PS(Cap((string)sal[1], 200)));
                        c.Parameters.AddWithValue("@dt", sal[2]);
                        c.Parameters.AddWithValue("@sd", start.HasValue ? (object)start.Value : DBNull.Value);
                        c.Parameters.AddWithValue("@ed", end.HasValue ? (object)end.Value : DBNull.Value);
                        c.Parameters.AddWithValue("@type", _typeWarranty);
                        c.Parameters.AddWithValue("@ex", sal[5]);
                        c.Parameters.AddWithValue("@br", sal[7]);
                        c.Parameters.AddWithValue("@yr", months / 12);
                        c.Parameters.AddWithValue("@mo", months % 12);
                        c.Parameters.AddWithValue("@rem", "Warranty of Sales Invoice " + (string)sal[1] + " (eBizWiz)");
                        c.Parameters.AddWithValue("@cp", sal[4]);
                        c.Parameters.AddWithValue("@mc", sal[0]);
                        c.Parameters.AddWithValue("@cbr", sal[6]);
                        c.Parameters.AddWithValue("@cb", MigrationUser);
                        c.Parameters.AddWithValue("@con", sal[8]);
                        c.Parameters.AddWithValue("@uon", sal[9]);
                        code = Convert.ToInt32(c.ExecuteScalar());
                    }

                    int lineN = 0, pmsN = 0, closedN = 0, skipN = 0;
                    foreach (DataRow s in serials)
                    {
                        int item; int pcode;
                        if (!itemByLine.TryGetValue(office + "|" + Int(s["nsales1"]), out item) || !_prodByItem.TryGetValue(item, out pcode)) { skipN++; continue; }
                        int months1 = Int(s["nmonths"]), pm = Int(s["npmvisits"]);
                        object intervals = DBNull.Value;   // visits per year, the values the contract form offers (0,1,2,3,4,6,12)
                        if (months1 > 0 && (pm * 12) % months1 == 0) { int py = pm * 12 / months1; if (py == 0 || py == 1 || py == 2 || py == 3 || py == 4 || py == 6 || py == 12) intervals = py; }
                        // remark = warranty months / PM visit count / closed (serial, dates, location, install date have their own columns)
                        List<string> bits = new List<string>();
                        string sn = Str(s["vserialno"]).Trim();
                        if (months1 > 0) bits.Add("Warranty: " + months1 + " months");
                        bits.Add("PM Visits: " + pm);
                        if (Bool(s["bclosed"])) bits.Add("Closed");
                        int det;
                        using (SqlCommand d = new SqlCommand(@"INSERT INTO contractdetails (contractcode, productcode, srno, invoiceno, invoicedate, installationdate, intervals, amount, location, startdate, enddate, iscomponent, remark, quantity, createdby, createdon, updatedby, updatedon)
                                                             OUTPUT INSERTED.code
                                                             VALUES (@c, @p, @sr, @inv, @invdt, @inst, @int, 0, @loc, @sd, @ed, 0, @rem, 1, @cb, @con, @cb, @uon)", tgt, tx))
                        {
                            d.Parameters.AddWithValue("@c", code);
                            d.Parameters.AddWithValue("@p", pcode);
                            d.Parameters.AddWithValue("@sr", PS(Cap(sn, 50)));
                            d.Parameters.AddWithValue("@inv", PS(Cap((string)sal[1], 50)));
                            d.Parameters.AddWithValue("@invdt", sal[2]);
                            d.Parameters.AddWithValue("@inst", P(s["dinstdate"]));
                            d.Parameters.AddWithValue("@int", intervals);
                            d.Parameters.AddWithValue("@loc", PS(Str(s["vlocation"])));
                            d.Parameters.AddWithValue("@sd", P(s["dstartdate"]));
                            d.Parameters.AddWithValue("@ed", P(s["denddate"]));
                            d.Parameters.AddWithValue("@rem", PS(string.Join(" | ", bits)));
                            d.Parameters.AddWithValue("@cb", MigrationUser);
                            d.Parameters.AddWithValue("@con", sal[8]);
                            d.Parameters.AddWithValue("@uon", sal[9]);
                            det = Convert.ToInt32(d.ExecuteScalar());
                        }
                        lineN++;

                        List<object[]> vs;
                        if (visits.TryGetValue(office + "|" + Int(s["ncode"]), out vs))
                        {
                            int k = 0;
                            foreach (object[] v in vs)
                            {
                                bool done = v[1] != DBNull.Value;
                                string cn; string callRemark = (int)v[2] > 0 ? "Call: " + (callNo.TryGetValue(office + "|" + (int)v[2], out cn) ? cn : "#" + (int)v[2]) : null;
                                using (SqlCommand q = new SqlCommand(@"INSERT INTO contractcall (contractdtcode, date, complaintdate, status, type, pmscomplaintno, ccode, productcode, serialno, closedt, remark, contactperson, createdby, createdon, updatedby, updatedon)
                                                                     VALUES (@dc, @dt, @dt, @st, 'PMS', @no, @cc, @p, @sr, @cl, @rem, @cp, @cb, @con, @cb, @uon)", tgt, tx))
                                {
                                    q.Parameters.AddWithValue("@dc", det);
                                    q.Parameters.AddWithValue("@dt", v[0]);
                                    q.Parameters.AddWithValue("@st", done ? _stClosed : _stOpen);
                                    q.Parameters.AddWithValue("@no", "PMS" + det.ToString("0000000") + "_" + k);
                                    q.Parameters.AddWithValue("@cc", sal[3]);
                                    q.Parameters.AddWithValue("@p", pcode);
                                    q.Parameters.AddWithValue("@sr", PS(Cap(sn, 50)));
                                    q.Parameters.AddWithValue("@cl", v[1]);
                                    q.Parameters.AddWithValue("@rem", PS(callRemark));
                                    q.Parameters.AddWithValue("@cp", sal[4]);
                                    q.Parameters.AddWithValue("@cb", MigrationUser);
                                    q.Parameters.AddWithValue("@con", sal[8]);
                                    q.Parameters.AddWithValue("@uon", done ? v[1] : sal[9]);
                                    q.ExecuteNonQuery();
                                }
                                k++; pmsN++; if (done) closedN++;
                            }
                        }
                    }
                    if (lineN == 0) { tx.Rollback(); _skipLines += skipN; return; }   // no migrated product on this invoice -> no empty contract
                    tx.Commit();
                    _rows++; _lines += lineN; _skipLines += skipN; _pms += pmsN; _pmsClosed += closedN;
                    if (_rows % 1000 == 0) Console.WriteLine("  ... " + _rows + " warranty contracts");
                }
                catch { tx.Rollback(); throw; }
            }
        }

        // Source invoice (office|trhsales.ncode) -> migrated sal_order row. Invoice numbers repeat across offices (and can
        // repeat inside one), so the key is branch|number and each key is a queue consumed in source ncode order - the order
        // module 7 inserted them in. Shared with module 11 so both sides pick the same invoice. - Aftab Alam
        public static Dictionary<string, object[]> SalesOrderBySource(SqlConnection tgt)
        {
            Dictionary<int, int> branchByOffice = new Dictionary<int, int>();
            Dictionary<int, string> officeName = SrcLookupInt("SELECT ncode, vcompanyname FROM mstoffice WITH (NOLOCK)");
            foreach (int office in Offices)
            {
                string nm; string place = officeName.TryGetValue(office, out nm) && nm.Length > 0 ? Cap(nm, 100) : "Office " + office;
                using (SqlCommand q = new SqlCommand("SELECT code FROM companyaddress WHERE ccode=@cc AND place=@pl", tgt))
                { q.Parameters.AddWithValue("@cc", CompanyCode); q.Parameters.AddWithValue("@pl", place); object o = q.ExecuteScalar(); if (o != null && o != DBNull.Value) branchByOffice[office] = Convert.ToInt32(o); }
            }
            Dictionary<string, Queue<object[]>> tgtByNo = new Dictionary<string, Queue<object[]>>(StringComparer.OrdinalIgnoreCase);
            foreach (DataRow r in GetTgt("SELECT code, salorderno, salorderdt, ccode, contactperson, executive, cbranchcode, branchcode, createdon, updatedon FROM sal_order WITH (NOLOCK) WHERE type='SO' AND branchcode IS NOT NULL ORDER BY code").Tables[0].Rows)
            {
                string k = Int(r["branchcode"]) + "|" + Str(r["salorderno"]);
                Queue<object[]> q; if (!tgtByNo.TryGetValue(k, out q)) tgtByNo[k] = q = new Queue<object[]>();
                q.Enqueue(new object[] { Int(r["code"]), Str(r["salorderno"]), P(r["salorderdt"]), P(r["ccode"]), P(r["contactperson"]), P(r["executive"]), P(r["cbranchcode"]), P(r["branchcode"]), P(r["createdon"]), P(r["updatedon"]) });
            }
            Dictionary<string, object[]> map = new Dictionary<string, object[]>();
            foreach (DataRow r in GetSrc("SELECT nofficeid, ncode, vtrnprefix, ntrnno FROM trhsales WITH (NOLOCK) WHERE nofficeid IN (" + OfficeIn + ") ORDER BY ncode").Tables[0].Rows)
            {
                int office = Int(r["nofficeid"]); int br; if (!branchByOffice.TryGetValue(office, out br)) continue;
                Queue<object[]> q; if (!tgtByNo.TryGetValue(br + "|" + (Str(r["vtrnprefix"]) + Str(r["ntrnno"])).Trim(), out q) || q.Count == 0) continue;
                map[office + "|" + Int(r["ncode"])] = q.Dequeue();
            }
            return map;
        }

        public static int WarrantyType(SqlConnection tgt)
        {
            using (SqlCommand q = new SqlCommand("SELECT TOP 1 code FROM amctype WHERE name='Warranty' ORDER BY code", tgt))
            { object o = q.ExecuteScalar(); if (o != null && o != DBNull.Value) return Convert.ToInt32(o); }
            using (SqlCommand ins = new SqlCommand("INSERT INTO amctype (name, createdby, createdon, updatedby, updatedon) OUTPUT INSERTED.code VALUES ('Warranty', @cb, GETDATE(), @cb, GETDATE())", tgt))
            { ins.Parameters.AddWithValue("@cb", MigrationUser); return Convert.ToInt32(ins.ExecuteScalar()); }
        }

        static int StatusCode(SqlConnection tgt, string name)
        {
            using (SqlCommand q = new SqlCommand("SELECT TOP 1 code FROM status WHERE module='AMC' AND name=@n ORDER BY code", tgt))
            { q.Parameters.AddWithValue("@n", name); object o = q.ExecuteScalar(); return o == null || o == DBNull.Value ? 0 : Convert.ToInt32(o); }
        }

        static void BuildProductMap(SqlConnection tgt)
        {
            Dictionary<string, int> byName = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
            foreach (DataRow r in GetTgt("SELECT code, name FROM product WITH (NOLOCK) ORDER BY isdeleted").Tables[0].Rows) { string n = Str(r["name"]); if (n.Length > 0 && !byName.ContainsKey(n)) byName[n] = Int(r["code"]); }
            //foreach (DataRow r in GetSrc("SELECT ncode, vname FROM mstitems WITH (NOLOCK) WHERE nofficeid IN (" + OfficeIn + ")").Tables[0].Rows)
            //{ string n = Cap(Str(r["vname"]), 150); int c; if (n.Length > 0 && byName.TryGetValue(n, out c) && !_prodByItem.ContainsKey(Int(r["ncode"]))) _prodByItem[Int(r["ncode"])] = c; }
            MapItemsToProducts(_prodByItem);   // Item Code + Name (not name only) - Aftab Alam
        }
    }

    // ==================================================================
    //  AMC CONTRACT BILLS -> SALES INVOICE (part of module 10, after AmcContract + WarrantyContract)
    //  EdifyBiz standard (amc/app/contract.aspx.cs): a contract billing cycle is billed by a Sales Invoice (sal_order type 'SO')
    //  linked with billingcycle.salcode - read by the Billing Cycle tab (Billed / Unbilled), the contract Invoice tab, the contract
    //  outstanding and the complaint view. The app's own AMC invoice line is the service product "Amc Product" (qty 1), and
    //  sal_order.module stays empty. Receipts (module 12) are then allocated to these invoices instead of sitting "on account"
    //  (on-account rows are shown as customer Advance on every Sales Invoice). Source: trdcontr3bills with a bill number
    //  (4,000; unique per office); taxable value and GST from the contract's item total and post-tax charges, scaled by the bill
    //  share of the contract total; invoice total = the eBizWiz bill amount. Mapping: Maping\13_payment_field_mapping.md. - Aftab Alam
    // ==================================================================
    static class AmcBillInvoice
    {
        static readonly Dictionary<int, int> _branchByOffice = new Dictionary<int, int>();
        static readonly Dictionary<string, object[]> _amcByKey = new Dictionary<string, object[]>();      // branch|contractno -> { code, ccode, contactperson, executive, contactbranch, branch, startdate, enddate }
        static readonly Dictionary<string, int[]> _billingByKey = new Dictionary<string, int[]>();        // amccode|billingno -> { billingcycle.code, salcode }
        static readonly Dictionary<string, object[]> _contract = new Dictionary<string, object[]>();      // office|trhcontr.ncode -> { contractno, ntotalamount, serial item total, header nitemtotal }
        static int _gstDropped, _gstImplied;
        static Dictionary<string, List<object[]>> _charges;
        static int _amcProduct, _label, _inr;
        static int _rows, _taxRows, _adjRows, _noContract, _noBilling, _already, _zero, _diff, _errors;
        static decimal _total;
        public static int DiffCount { get { return _diff; } }

        public static void Run()
        {
            Console.WriteLine("=====================================================");
            Console.WriteLine("   eBizWiz  ->  EdifyBiz   |   AMC contract bills -> Sales Invoice (billingcycle.salcode)");
            Console.WriteLine("=====================================================");
            Dictionary<int, string> officeName = SrcLookupInt("SELECT ncode, vcompanyname FROM mstoffice WITH (NOLOCK)");
            using (SqlConnection tgt = OpenTgt())
            {
                foreach (int office in Offices)
                {
                    string nm; string place = officeName.TryGetValue(office, out nm) && nm.Length > 0 ? Cap(nm, 100) : "Office " + office;
                    using (SqlCommand q = new SqlCommand("SELECT code FROM companyaddress WHERE ccode=@cc AND place=@pl", tgt))
                    { q.Parameters.AddWithValue("@cc", CompanyCode); q.Parameters.AddWithValue("@pl", place); object o = q.ExecuteScalar(); if (o != null && o != DBNull.Value) _branchByOffice[office] = Convert.ToInt32(o); }
                }
                _amcProduct = EnsureAmcProduct(tgt);
                SalesInvoice.PrepareExternalTax(tgt);          // after the product exists, so its type 's' is known to the tax rules
                _label = SalesInvoice.SalesLabelFor(tgt, "AMC Contract Bill", "#4B8DF8");
                _inr = SalesInvoice.InrCode(tgt);
                _charges = LoadPostTaxCharges("trdcontr4posttaxchgs", "ncontr");

                foreach (DataRow r in GetTgt("SELECT code, ccode, contactperson, executive, contactbranch, branch, contractno, startdate, enddate FROM amc WITH (NOLOCK) WHERE contractno IS NOT NULL AND ISNULL(module,'') <> 'SAL'").Tables[0].Rows)
                { string k = Str(r["branch"]) + "|" + Str(r["contractno"]); if (!_amcByKey.ContainsKey(k)) _amcByKey[k] = new object[] { Int(r["code"]), r["ccode"], r["contactperson"], r["executive"], r["contactbranch"], r["branch"], r["startdate"], r["enddate"] }; }
                foreach (DataRow r in GetTgt("SELECT code, amccode, billingno, ISNULL(salcode,0) AS salcode FROM billingcycle WITH (NOLOCK) WHERE billingno IS NOT NULL").Tables[0].Rows)
                { string k = Int(r["amccode"]) + "|" + Str(r["billingno"]); if (!_billingByKey.ContainsKey(k)) _billingByKey[k] = new[] { Int(r["code"]), Int(r["salcode"]) }; }
                Dictionary<string, decimal> itemTotal = new Dictionary<string, decimal>();
                foreach (DataRow r in GetSrc(@"SELECT d.nofficeid, d.ncontr, SUM(d.nrate) AS t FROM trdcontr2itemsdet d WITH (NOLOCK)
                                               WHERE d.nofficeid IN (" + OfficeIn + @") AND EXISTS (SELECT 1 FROM trdcontr1items i WITH (NOLOCK) WHERE i.nofficeid = d.nofficeid AND i.ncode = d.ncontr1)
                                               GROUP BY d.nofficeid, d.ncontr").Tables[0].Rows)
                    itemTotal[Int(r["nofficeid"]) + "|" + Int(r["ncontr"])] = Dec(r["t"]);
                foreach (DataRow r in GetSrc("SELECT nofficeid, ncode, vtrnprefix, ntrnno, ntotalamount, nitemtotal FROM trhcontr WITH (NOLOCK) WHERE nofficeid IN (" + OfficeIn + ")").Tables[0].Rows)
                {
                    string k = Int(r["nofficeid"]) + "|" + Int(r["ncode"]); decimal it; itemTotal.TryGetValue(k, out it);
                    //_contract[k] = new object[] { (Str(r["vtrnprefix"]) + Str(r["ntrnno"])).Trim(), Dec(r["ntotalamount"]), it };
                    _contract[k] = new object[] { (Str(r["vtrnprefix"]) + Str(r["ntrnno"])).Trim(), Dec(r["ntotalamount"]), it, Dec(r["nitemtotal"]) };
                }

                // bills in module 10's order (billingno BILL_<right-10 contract no>_<n>, n counted over ALL bills of the contract)
                DataTable bills = GetSrc(@"SELECT nofficeid, ncode, ncontr, nbillno, dbilldate, nbillamount, namountrecd, addedon, editedon FROM trdcontr3bills WITH (NOLOCK)
                                           WHERE nofficeid IN (" + OfficeIn + ") ORDER BY nofficeid, ncontr, dbilldate, ncode").Tables[0];
                Dictionary<string, int> count = new Dictionary<string, int>();
                foreach (DataRow r in bills.Rows) { string ck = Int(r["nofficeid"]) + "|" + Int(r["ncontr"]); int c; count.TryGetValue(ck, out c); count[ck] = c + 1; }
                Dictionary<string, int> seq = new Dictionary<string, int>();
                foreach (DataRow r in bills.Rows)
                {
                    int office = Int(r["nofficeid"]); string ck = office + "|" + Int(r["ncontr"]);
                    int i; seq.TryGetValue(ck, out i); seq[ck] = ++i;
                    if (Int(r["nbillno"]) <= 0) continue;                                   // not billed in eBizWiz -> stays Unbilled
                    if (Dec(r["nbillamount"]) == 0) { _zero++; continue; }
                    try { InsertBill(tgt, r, office, ck, i, count[ck]); }
                    catch (Exception ex) { _errors++; if (_errors <= 20) Console.WriteLine("  [ERROR] AMC bill " + office + "|" + Int(r["ncode"]) + ": " + ex.Message); }
                }
                Console.WriteLine("-----------------------------------------------------");
                Console.WriteLine("  AMC bill invoices       : " + _rows + "  total " + _total.ToString("0.00", CultureInfo.InvariantCulture) + "  (sal_tax rows " + _taxRows + ", adjustments " + _adjRows + ", with bill difference line " + _diff + ")");
                Console.WriteLine("  GST from contract total : not charged (GST row, total without it) " + _gstDropped + " bills, included in total (no GST row) " + _gstImplied + " bills");
                Console.WriteLine("  Skipped                 : amount 0 " + _zero + ", contract not migrated " + _noContract + ", billing cycle not found " + _noBilling + ", already invoiced " + _already);
                Console.WriteLine("  Errors                  : " + _errors);
                Console.WriteLine("-----------------------------------------------------");
            }
        }

        static void InsertBill(SqlConnection tgt, DataRow r, int office, string ck, int n, int of)
        {
            object[] con; int br;
            if (!_contract.TryGetValue(ck, out con) || !_branchByOffice.TryGetValue(office, out br)) { _noContract++; return; }
            string contractno = (string)con[0];
            object[] amc; if (!_amcByKey.TryGetValue(br + "|" + contractno, out amc)) { _noContract++; return; }
            string pad = ("0000000000" + contractno); pad = pad.Substring(pad.Length - 10);
            int[] bc; if (!_billingByKey.TryGetValue((int)amc[0] + "|BILL_" + pad + "_" + n, out bc)) { _noBilling++; return; }
            if (bc[1] > 0) { _already++; return; }

            //decimal bill = Dec(r["nbillamount"]), total = (decimal)con[1], items = (decimal)con[2];
            // Item value = the contract header item total (2 contracts' serial rows add up to more than the header); serial sum only when the header has none. - Aftab Alam
            decimal bill = Dec(r["nbillamount"]), total = (decimal)con[1], items = (decimal)con[3] > 0 ? (decimal)con[3] : (decimal)con[2];
            decimal lineVal; List<object[]> charges = null;
            if (total != 0 && items != 0)
            {
                decimal s = bill / total;
                lineVal = Math.Round(items * s, 2);
                //List<object[]> src; if (_charges.TryGetValue(ck, out src))
                List<object[]> src0; _charges.TryGetValue(ck, out src0);
                List<object[]> src = GstByContractTotal(items, total, src0);
                if (src != null)
                {
                    charges = new List<object[]>();
                    foreach (object[] ch in src)                                              // PERCENTAGE stays a % of the (scaled) item value, AMOUNT is scaled
                        charges.Add(new object[] { ch[0], ch[1], ch[2], (string)ch[1] == "PERCENTAGE" ? ch[3] : (object)Math.Round((decimal)ch[3] * s, 2), ch[4] });
                }
            }
            else lineVal = bill;

            string billno = Int(r["nbillno"]).ToString(CultureInfo.InvariantCulture);
            object date = P(r["dbilldate"]);
            object createdon = r["addedon"] != DBNull.Value ? r["addedon"] : date;
            object updatedon = r["editedon"] != DBNull.Value ? r["editedon"] : createdon;
            List<string> rem = new List<string>();
            rem.Add("AMC Contract: " + contractno + " | Bill " + n + " of " + of + " (eBizWiz AMC bill)");
            rem.Add("eBizWiz Bill Amount: " + bill.ToString("0.##", CultureInfo.InvariantCulture));
            if (Dec(r["namountrecd"]) != 0) rem.Add("Amount Received: " + Dec(r["namountrecd"]).ToString("0.##", CultureInfo.InvariantCulture));
            string period = Dt(amc[6]) + (amc[7] != DBNull.Value ? " - " + Dt(amc[7]) : "");

            using (SqlTransaction tx = tgt.BeginTransaction())
            {
                try
                {
                    int code;
                    using (SqlCommand c = new SqlCommand(@"INSERT INTO sal_order (salorderno, salorderdt, ccode, contactperson, executive, cbranchcode, currency, remarks, branchcode, comcode, [type], createdby, updatedby, createdon, updatedon)
                                                         OUTPUT INSERTED.code VALUES (@no, @dt, @cc, @cp, @ex, @bill, @cur, @rem, @br, @com, 'SO', @cb, @cb, @con, @uon)", tgt, tx))
                    {
                        c.Parameters.AddWithValue("@no", billno);
                        c.Parameters.AddWithValue("@dt", date);
                        c.Parameters.AddWithValue("@cc", amc[1]);
                        c.Parameters.AddWithValue("@cp", amc[2]);
                        c.Parameters.AddWithValue("@ex", amc[3] != DBNull.Value ? amc[3] : (object)MigrationUser);
                        c.Parameters.AddWithValue("@bill", amc[4]);
                        c.Parameters.AddWithValue("@cur", _inr > 0 ? (object)_inr : DBNull.Value);
                        c.Parameters.AddWithValue("@rem", PS(string.Join(" | ", rem)));
                        c.Parameters.AddWithValue("@br", amc[5]);
                        c.Parameters.AddWithValue("@com", CompanyCode);
                        c.Parameters.AddWithValue("@cb", MigrationUser);
                        c.Parameters.AddWithValue("@con", createdon);
                        c.Parameters.AddWithValue("@uon", updatedon);
                        code = Convert.ToInt32(c.ExecuteScalar());
                    }
                    int det;
                    using (SqlCommand d = new SqlCommand(@"INSERT INTO sal_order_det (salcode, prodcode, qty, price, currency, warrantymonths, prod_desc, createdby, updatedby, createdon, updatedon)
                                                         OUTPUT INSERTED.code VALUES (@sc, @p, 1, @pr, @cur, 0, @pd, @cb, @cb, @con, @uon)", tgt, tx))
                    {
                        d.Parameters.AddWithValue("@sc", code);
                        d.Parameters.AddWithValue("@p", _amcProduct);
                        d.Parameters.AddWithValue("@pr", lineVal);
                        d.Parameters.AddWithValue("@cur", _inr > 0 ? (object)_inr : DBNull.Value);
                        d.Parameters.AddWithValue("@pd", PS("AMC Contract " + contractno + (period.Trim().Length > 0 ? " (" + period.Trim() + ")" : "") + ", Bill " + n + " of " + of));
                        d.Parameters.AddWithValue("@cb", MigrationUser);
                        d.Parameters.AddWithValue("@con", createdon);
                        d.Parameters.AddWithValue("@uon", updatedon);
                        det = Convert.ToInt32(d.ExecuteScalar());
                    }
                    List<object[]> dets = new List<object[]> { new object[] { det, _amcProduct, lineVal } };
                    int[] ts = SalesInvoice.ApplyTaxFor(tgt, tx, code, "AMCBILL|" + office + "|" + Int(r["ncode"]), amc[4], dets, new Dictionary<int, decimal>(), lineVal, 0m, charges, createdon, updatedon);
                    int adj = ts[1] + BillDifference(tgt, tx, code, bill, createdon, updatedon);

                    using (SqlCommand l = new SqlCommand("INSERT INTO labelrelation (label, module, createdon, createdby) VALUES (@l, @m, @con, @cb)", tgt, tx))
                    { l.Parameters.AddWithValue("@l", _label); l.Parameters.AddWithValue("@m", code); l.Parameters.AddWithValue("@con", createdon); l.Parameters.AddWithValue("@cb", MigrationUser); l.ExecuteNonQuery(); }
                    using (SqlCommand u = new SqlCommand("UPDATE billingcycle SET salcode=@s WHERE code=@c", tgt, tx))
                    { u.Parameters.AddWithValue("@s", code); u.Parameters.AddWithValue("@c", bc[0]); u.ExecuteNonQuery(); }

                    tx.Commit();
                    bc[1] = code; _rows++; _taxRows += ts[0]; _adjRows += adj; _total += bill;
                    if (_rows % 1000 == 0) Console.WriteLine("  ... " + _rows + " AMC bill invoices");
                }
                catch { tx.Rollback(); throw; }
            }
        }

        // GST decided by the eBizWiz contract total (checked on the 2,660 billed contracts: items + charges = total on 2,575):
        //  * a GST row whose amount is NOT in the total (total = items + other charges; 1 contract, MC360) -> that GST row is dropped;
        //  * no GST row but total = (items + other charges) x (1 + r%) for r = 18 / 12 / 5 / 28 (76 contracts, all 18%) -> GST r% added;
        //  * anything else as entered; what the invoice cannot carry ends in "Bill difference (eBizWiz)" (8 contracts whose own figures disagree). - Aftab Alam
        static List<object[]> GstByContractTotal(decimal items, decimal total, List<object[]> src)
        {
            decimal gst = 0m, oth = 0m;
            if (src != null)
                foreach (object[] ch in src)
                {
                    string label = (string)ch[0]; bool pct = (string)ch[1] == "PERCENTAGE";
                    decimal v = pct ? Math.Round(items * (decimal)ch[2] / 100m, 2) : (decimal)ch[3];
                    if (label.IndexOf("GST", StringComparison.OrdinalIgnoreCase) >= 0 && label.IndexOf(" on ", StringComparison.OrdinalIgnoreCase) < 0) gst += v; else oth += v;
                }
            if (gst != 0 && Math.Abs(total - (items + oth + gst)) > 1m && Math.Abs(total - (items + oth)) <= 1m)
            {
                _gstDropped++;
                return src.Where(ch => !(((string)ch[0]).IndexOf("GST", StringComparison.OrdinalIgnoreCase) >= 0 && ((string)ch[0]).IndexOf(" on ", StringComparison.OrdinalIgnoreCase) < 0)).ToList();
            }
            if (gst == 0 && Math.Abs(total - (items + oth)) > 1m)
                foreach (decimal rate in new[] { 18m, 12m, 5m, 28m })
                    if (Math.Abs(total - (items + oth) * (1m + rate / 100m)) <= 1m)
                    {
                        _gstImplied++;
                        List<object[]> l = src != null ? new List<object[]>(src) : new List<object[]>();
                        l.Add(new object[] { "GST @" + rate.ToString("0.##", CultureInfo.InvariantCulture) + "% (included in eBizWiz total)", "PERCENTAGE", rate, 0m, false });
                        return l;
                    }
            return src;
        }

        // Invoice total as payments / outstanding compute it (lines + sal_tax + sal_adjust) must equal the eBizWiz bill; any rest -> one adjustment.
        public static int BillDifference(SqlConnection tgt, SqlTransaction tx, int salcode, decimal bill, object createdon, object updatedon)
        {
            decimal now;
            using (SqlCommand q = new SqlCommand(@"SELECT (SELECT ISNULL(SUM(ISNULL(qty,0)*ISNULL(price,0)-ISNULL(discount,0)),0) FROM sal_order_det WHERE salcode=@s)
                                                        + (SELECT ISNULL(SUM(taxamount),0) FROM sal_tax WHERE sal_code=@s)
                                                        + (SELECT ISNULL(SUM(adjustamount),0) FROM sal_adjust WHERE salcode=@s)", tgt, tx))
            { q.Parameters.AddWithValue("@s", salcode); now = Dec(q.ExecuteScalar()); }
            decimal diff = Math.Round(bill - now, 2);
            if (diff == 0) return 0;
            using (SqlCommand q = new SqlCommand(@"INSERT INTO sal_adjust (salcode, adjustname, adjustpercent, adjustamount, beforetax, createdby, updatedby, createdon, updatedon)
                                                 VALUES (@s, @n, 0, @a, 0, @cb, @cb, @con, @uon)", tgt, tx))
            {
                q.Parameters.AddWithValue("@s", salcode);
                q.Parameters.AddWithValue("@n", Math.Abs(diff) <= 1m ? "Bill rounding (eBizWiz)" : "Bill difference (eBizWiz)");
                q.Parameters.AddWithValue("@a", diff);
                q.Parameters.AddWithValue("@cb", MigrationUser);
                q.Parameters.AddWithValue("@con", createdon);
                q.Parameters.AddWithValue("@uon", updatedon);
                q.ExecuteNonQuery();
            }
            if (Math.Abs(diff) > 1m) _diff++;
            return 1;
        }

        // Same product the app creates for an AMC invoice (gst/sales/app/sales.asp GetSalesAmcProduct): name 'Amc Product', service.
        static int EnsureAmcProduct(SqlConnection tgt)
        {
            using (SqlCommand q = new SqlCommand("SELECT TOP 1 code FROM product WHERE name = 'Amc Product' ORDER BY code", tgt))
            { object o = q.ExecuteScalar(); if (o != null && o != DBNull.Value) return Convert.ToInt32(o); }
            using (SqlCommand ins = new SqlCommand("INSERT INTO product (casno, name, sname, type, createdby, createdon, updatedby, updatedon) OUTPUT INSERTED.code VALUES ('amc', 'Amc Product', 'amc', 's', @cb, GETDATE(), @cb, GETDATE())", tgt))
            { ins.Parameters.AddWithValue("@cb", MigrationUser); return Convert.ToInt32(ins.ExecuteScalar()); }
        }

        static string Dt(object v) { return v == null || v == DBNull.Value ? "" : Convert.ToDateTime(v).ToString("dd/MM/yyyy", CultureInfo.InvariantCulture); }
    }

    // ==================================================================
    //  SERVICE CALL BILLS -> SALES INVOICE (part of module 11, after Complaint)
    //  eBizWiz bills a call on the Service Entry itself (Bill No = vinvoiceprefix + ninvoiceno, parts / labour lines with their
    //  tax, post-tax charges). EdifyBiz bills service through a Sales Invoice; our complaint has no invoice link, so the invoice
    //  names the call in its remark and carries the label "Service Call Bill" (module 12 finds it by that label + number).
    //  Lines = the call's parts (LABOUR items are service products). Stock: the spares on these calls already left stock through
    //  the call's MRO (module 11), so no SAL stock row is posted here. Zero-value bills (no receipts in eBizWiz) are skipped. - Aftab Alam
    // ==================================================================
    static class CallBillInvoice
    {
        static readonly Dictionary<int, int> _branchByOffice = new Dictionary<int, int>();
        static readonly Dictionary<int, int> _prodByItem = new Dictionary<int, int>();
        static readonly Dictionary<string, object[]> _callByNo = new Dictionary<string, object[]>();     // call no -> { code, ccode, contactperson, contactbranch, assignedto }
        static readonly Dictionary<string, List<object[]>> _parts = new Dictionary<string, List<object[]>>();
        static readonly Dictionary<int, string> _prodType = new Dictionary<int, string>();
        static Dictionary<string, List<object[]>> _charges;
        static Dictionary<int, string> _taxsetName;
        static Dictionary<int, int> _batchByProd;
        public const string LabelName = "Service Call Bill";
        static int _label, _inr;
        static int _rows, _lines, _skipLines, _taxRows, _adjRows, _zero, _noCall, _exists, _diff, _errors;
        static decimal _total;

        public static void Run()
        {
            Console.WriteLine("=====================================================");
            Console.WriteLine("   eBizWiz  ->  EdifyBiz   |   Service call bills -> Sales Invoice");
            Console.WriteLine("=====================================================");
            Dictionary<int, string> officeName = SrcLookupInt("SELECT ncode, vcompanyname FROM mstoffice WITH (NOLOCK)");
            using (SqlConnection tgt = OpenTgt())
            {
                foreach (int office in Offices)
                {
                    string nm; string place = officeName.TryGetValue(office, out nm) && nm.Length > 0 ? Cap(nm, 100) : "Office " + office;
                    using (SqlCommand q = new SqlCommand("SELECT code FROM companyaddress WHERE ccode=@cc AND place=@pl", tgt))
                    { q.Parameters.AddWithValue("@cc", CompanyCode); q.Parameters.AddWithValue("@pl", place); object o = q.ExecuteScalar(); if (o != null && o != DBNull.Value) _branchByOffice[office] = Convert.ToInt32(o); }
                }
                SalesInvoice.PrepareExternalTax(tgt);
                _label = SalesInvoice.SalesLabelFor(tgt, LabelName, "#E08283");
                _inr = SalesInvoice.InrCode(tgt);
                _taxsetName = SrcLookupInt("SELECT ncode, vname FROM msttaxset WITH (NOLOCK)");
                _batchByProd = DefaultBatchByProduct();
                _charges = LoadPostTaxCharges("trdcalls6posttaxchgs", "ncalls");
                foreach (DataRow r in GetTgt("SELECT code, type FROM product").Tables[0].Rows) _prodType[Int(r["code"])] = Str(r["type"]).ToLowerInvariant();
                Dictionary<string, int> byName = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
                foreach (DataRow r in GetTgt("SELECT code, name FROM product WITH (NOLOCK) ORDER BY isdeleted").Tables[0].Rows) { string n = Str(r["name"]); if (n.Length > 0 && !byName.ContainsKey(n)) byName[n] = Int(r["code"]); }
                //foreach (DataRow r in GetSrc("SELECT ncode, vname FROM mstitems WITH (NOLOCK) WHERE nofficeid IN (" + OfficeIn + ")").Tables[0].Rows)
                //{ string n = Cap(Str(r["vname"]), 150); int c; if (n.Length > 0 && byName.TryGetValue(n, out c) && !_prodByItem.ContainsKey(Int(r["ncode"]))) _prodByItem[Int(r["ncode"])] = c; }
                MapItemsToProducts(_prodByItem);   // Item Code + Name (not name only) - Aftab Alam
                foreach (DataRow r in GetTgt("SELECT code, pmscomplaintno, ccode, contactperson, contactbranch, assignedto FROM contractcall WITH (NOLOCK) WHERE pmscomplaintno IS NOT NULL").Tables[0].Rows)
                { string k = Str(r["pmscomplaintno"]); if (!_callByNo.ContainsKey(k)) _callByNo[k] = new object[] { Int(r["code"]), r["ccode"], r["contactperson"], r["contactbranch"], r["assignedto"] }; }
                HashSet<string> existing = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
                foreach (DataRow r in GetTgt("SELECT s.branchcode, s.salorderno FROM sal_order s JOIN labelrelation lr ON lr.module = s.code WHERE lr.label = " + _label).Tables[0].Rows)
                    existing.Add(Str(r["branchcode"]) + "|" + Str(r["salorderno"]));
                // { 0 item, 1 qty, 2 rate, 3 taxset, 4 taxamt, 5 remarks }
                foreach (DataRow r in GetSrc("SELECT nofficeid, ncalls, nitem, nquantity, nrate, ntaxset, ntaxamt, vremarks FROM trdcalls3parts WITH (NOLOCK) WHERE nofficeid IN (" + OfficeIn + ") ORDER BY nofficeid, ncalls, ncode").Tables[0].Rows)
                {
                    string k = Int(r["nofficeid"]) + "|" + Int(r["ncalls"]);
                    List<object[]> l; if (!_parts.TryGetValue(k, out l)) _parts[k] = l = new List<object[]>();
                    l.Add(new object[] { Int(r["nitem"]), Dec(r["nquantity"]), Dec(r["nrate"]), Int(r["ntaxset"]), Dec(r["ntaxamt"]), Str(r["vremarks"]) });
                }

                foreach (DataRow h in GetSrc(@"SELECT nofficeid, ncode, vtrnno, vtrnprefix, ntrnno, dtrndate, vinvoiceprefix, ninvoiceno, dinvoicedt, ntotalamount, addedon, editedon
                                               FROM trhcalls WITH (NOLOCK) WHERE nofficeid IN (" + OfficeIn + ") AND ISNULL(ninvoiceno,0) <> 0 ORDER BY nofficeid, ncode").Tables[0].Rows)
                {
                    try
                    {
                        if (Dec(h["ntotalamount"]) == 0) { _zero++; continue; }
                        int br; if (!_branchByOffice.TryGetValue(Int(h["nofficeid"]), out br)) { _noCall++; continue; }
                        string billno = (Str(h["vinvoiceprefix"]) + Int(h["ninvoiceno"]).ToString(CultureInfo.InvariantCulture)).Trim();
                        if (existing.Contains(br + "|" + billno)) { _exists++; continue; }
                        InsertBill(tgt, h, br, billno);
                        existing.Add(br + "|" + billno);
                    }
                    catch (Exception ex) { _errors++; if (_errors <= 20) Console.WriteLine("  [ERROR] Call bill " + Int(h["nofficeid"]) + "|" + Int(h["ncode"]) + ": " + ex.Message); }
                }
                Console.WriteLine("-----------------------------------------------------");
                Console.WriteLine("  Service call invoices   : " + _rows + "  total " + _total.ToString("0.00", CultureInfo.InvariantCulture) + "  lines " + _lines + " (skipped, item not migrated " + _skipLines + ")");
                Console.WriteLine("  Tax                     : sal_tax rows " + _taxRows + ", adjustments " + _adjRows + ", with bill difference line " + _diff);
