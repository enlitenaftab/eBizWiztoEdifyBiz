        // ---------- one call ----------
        static void InsertRow(SqlConnection tgt, DataRow h)
        {
            int office = Int(h["nofficeid"]); int srcCode = Int(h["ncode"]); string key = office + "|" + srcCode;
            string callno = Str(h["vtrnno"]); if (callno.Length == 0) callno = (Str(h["vtrnprefix"]) + Str(h["ntrnno"])).Trim();
            string trnno = (Str(h["vtrnprefix"]) + Str(h["ntrnno"])).Trim();
            string partyKey = NKey(h["nparty"]);
            object ccode = DBNull.Value, cbranch = DBNull.Value; int cid, br;
            if (partyKey.Length > 0 && _custByParty.TryGetValue(partyKey, out cid)) { ccode = cid; if (_branchByContact.TryGetValue(cid, out br)) cbranch = br; }
            int mlt; object contactperson = Int(h["npartycontact"]) > 0 && _persons.TryGetValue(partyKey + "|" + Int(h["npartycontact"]), out mlt) ? (object)mlt : DBNull.Value;
            int ex; object assignedto = UserByCode.TryGetValue(NKey(h["nengineer"]), out ex) ? (object)ex : DBNull.Value;
            int pc; object productcode = _prodByItem.TryGetValue(Int(h["nitem"]), out pc) ? (object)pc : DBNull.Value;
            int ct; object complainttype = _ctByComplaint.TryGetValue(Int(h["ncomplaint"]), out ct) ? (object)ct : DBNull.Value;

            DateTime? calldate = Date(h["dtrndate"]);
            string calltype = LookInt(_fixed, Int(h["ncalltype"]));
            //Det det = ResolveDet(NKey(h["nitemserialno"]), calldate);
            Det det = ResolveDet(NKey(h["nitemserialno"]), calldate, calltype.ToUpperInvariant().Replace(" ", "").Contains("INSTALLATION"));
            string type = TypeOf(calltype, det != null);
            object contractdtcode = det != null ? (object)det.Code : (object)0;
            if (det != null) { if (det.Ccode > 0) ccode = det.Ccode; if (det.Pcode > 0) productcode = det.Pcode; }
            string serialno = Str(h["vserialno"]); if (serialno.Length == 0 && det != null) serialno = det.Srno;

            // Status: solved -> Closed, cancel reason (not solved) -> Cancelled, else Open
            bool solved = Bool(h["bsolved"]);
            int status = solved ? _stClosed : (Int(h["ncancelreason"]) > 0 ? _stCancel : _stOpen);
            object closedt = solved ? P(h["dsolvedatetime"]) : DBNull.Value;

            // date / preferredtimein = appointment date (the app writes Visit Date+Time into both); no appointment -> call date
            object visitdt = h["dapptdatetime"] != DBNull.Value ? h["dapptdatetime"] : (calldate.HasValue ? (object)calldate.Value : DBNull.Value);
            object visitout = visitdt != DBNull.Value ? (object)Convert.ToDateTime(visitdt).AddHours(2) : DBNull.Value;
            object createdon = P(h["addedon"]);
            object updatedon = h["editedon"] != DBNull.Value ? h["editedon"] : createdon;

            List<string> rem = new List<string>();
            string cmt = Str(h["vcomment"]); if (cmt.Length > 0) rem.Add(cmt);
            if (calltype.Length > 0) rem.Add("Call Type: " + calltype);
            rem.Add("Call No: " + callno + (trnno.Length > 0 ? " | Trn No: " + trnno : "") + " | " + LookInt(_officeName, office));
            string logged = LookStr(_userName, NKey(h["addedby"])); if (logged.Length > 0) rem.Add("Call Logged By: " + logged);
            string pcall = Str(h["vpersoncalling"]); if (pcall.Length > 0) rem.Add("Person Calling: " + pcall);
            if (Int(h["nTransferTo"]) > 0) rem.Add("Transfer To: " + LookInt(_officeName, Int(h["nTransferTo"])));
            string loc = Str(h["vlocation"]); if (loc.Length > 0) rem.Add("Location: " + loc);
            if (Bool(h["bitemchange"])) rem.Add("Change Item: Yes");
            if (Bool(h["bwvoid"])) rem.Add("Warranty Void: Yes");
            if (h["ddateofpurchase"] != DBNull.Value) rem.Add("Purchase / Start Date: " + Dt(h["ddateofpurchase"]));
            if (Int(h["nwarrmonth"]) > 0) rem.Add("Months: " + Int(h["nwarrmonth"]));
            string setc = Str(h["vsetcondition"]); if (setc.Length > 0) rem.Add("Product Condition / Accessory Recd.: " + setc);
            if (h["dallocationdatetime"] != DBNull.Value) rem.Add("Allocation Date: " + Dt(h["dallocationdatetime"]));
            //string cset = LookInt(_checkset, Int(h["ncheckset"])); if (cset.Length > 0) rem.Add("Check List: " + cset);   // check set -> Checklist Master; items are in the Task Check List tab, not in the remark - Aftab Alam
            if (Bool(h["baccepted"])) rem.Add("Accepted" + (h["dacceptdate"] != DBNull.Value ? " on " + Dt(h["dacceptdate"]) : ""));
            string billno = (Str(h["vinvoiceprefix"]) + (Int(h["ninvoiceno"]) > 0 ? Str(h["ninvoiceno"]) : "")).Trim();
            if (billno.Length > 0) rem.Add("Bill No: " + billno + (h["dinvoicedt"] != DBNull.Value ? " dt. " + Dt(h["dinvoicedt"]) : ""));
            string pr = LookInt(_pendReason, Int(h["npendingreason"])); if (pr.Length > 0) rem.Add("Pending Reason: " + pr);
            string cr = LookInt(_cancelReason, Int(h["ncancelreason"])); if (cr.Length > 0) rem.Add("Cancel Reason: " + cr);
            if (Bool(h["bfastclose"])) rem.Add("Fast Close" + (h["dfastclosedatetime"] != DBNull.Value ? " on " + Dt(h["dfastclosedatetime"]) : ""));
            if (Bool(h["bvalidation"])) rem.Add("Validation Done: Yes");
            List<object[]> loose; if (_faults.TryGetValue(key + "|0", out loose)) foreach (object[] f in loose) rem.Add(FaultText(f));

            List<object[]> visits; _visits.TryGetValue(key, out visits);
            List<object[]> parts; _parts.TryGetValue(key, out parts);
            List<object[]> checks; _checks.TryGetValue(key, out checks);
            List<object[]> pend; _pending.TryGetValue(key, out pend);

            int existing; bool isUpdate = _pmsByCall.TryGetValue(key, out existing);

            using (SqlTransaction tx = tgt.BeginTransaction())
            {
                try
                {
                    int code;
                    if (isUpdate)
                    {
                        code = existing;
                        // PMS row created by module 10: keep its scheduled date / contract link / type, fill in the call's own data.
                        using (SqlCommand u = new SqlCommand(@"UPDATE contractcall SET pmscomplaintno=@no, reportno=@rno, complaintdate=@cdt, complaint=@ct, status=@st,
                                                                     assignedto=ISNULL(@as, assignedto), callamt=@amt, preferredtimein=@pin, preferredtimeout=@pout,
                                                                     closedt=@cl, remark=@rem, contactperson=ISNULL(@cp, contactperson), contactbranch=ISNULL(@cbr, contactbranch),
                                                                     servicecomplaint=@sc, Observation=@ob, servicedetails=@sd, serialno=ISNULL(@sr, serialno),
                                                                     updatedby=@cb, updatedon=@uon
                                                              WHERE code=@c", tgt, tx))
                        {
                            u.Parameters.AddWithValue("@no", PS(Cap(callno, 50)));
                            u.Parameters.AddWithValue("@rno", PS(Cap(trnno, 50)));
                            u.Parameters.AddWithValue("@cdt", P(h["dtrndate"]));
                            u.Parameters.AddWithValue("@ct", complainttype);
                            u.Parameters.AddWithValue("@st", status);
                            u.Parameters.Add("@as", SqlDbType.Int).Value = assignedto;              // typed: ISNULL(@as, assignedto) must stay int - Aftab Alam
                            u.Parameters.AddWithValue("@amt", Dec(h["ntotalamount"]));
                            u.Parameters.AddWithValue("@pin", visitdt);
                            u.Parameters.AddWithValue("@pout", visitout);
                            u.Parameters.AddWithValue("@cl", closedt);
                            u.Parameters.AddWithValue("@rem", PS(string.Join(" | ", rem)));
                            u.Parameters.Add("@cp", SqlDbType.Int).Value = contactperson;
                            u.Parameters.Add("@cbr", SqlDbType.Int).Value = cbranch;
                            u.Parameters.AddWithValue("@sc", PS(Str(h["vcomplaint"])));
                            u.Parameters.AddWithValue("@ob", PS(Str(h["vspecialinstructions"])));
                            u.Parameters.AddWithValue("@sd", PS(Str(h["vsolveremarks"])));
                            u.Parameters.Add("@sr", SqlDbType.NVarChar, 50).Value = PS(Cap(serialno, 50));
                            u.Parameters.AddWithValue("@cb", MigrationUser);
                            u.Parameters.AddWithValue("@uon", updatedon);
                            u.Parameters.AddWithValue("@c", code);
                            u.ExecuteNonQuery();
                        }
                    }
                    else
                    {
                        using (SqlCommand c = new SqlCommand(@"INSERT INTO contractcall (contractdtcode, date, complaintdate, complaint, status, type, assignedto, callamt,
                                                                                         pmscomplaintno, reportno, preferredtimein, preferredtimeout, ccode, productcode, serialno,
                                                                                         closedt, remark, contactperson, contactbranch, servicecomplaint, Observation, servicedetails,
                                                                                         createdby, createdon, updatedby, updatedon)
                                                              OUTPUT INSERTED.code
                                                              VALUES (@dc, @dt, @cdt, @ct, @st, @ty, @as, @amt, @no, @rno, @pin, @pout, @cc, @p, @sr, @cl, @rem, @cp, @cbr, @sc, @ob, @sd, @cb, @con, @cb, @uon)", tgt, tx))
                        {
                            c.Parameters.AddWithValue("@dc", contractdtcode);
                            c.Parameters.AddWithValue("@dt", visitdt);
                            c.Parameters.AddWithValue("@cdt", P(h["dtrndate"]));
                            c.Parameters.AddWithValue("@ct", complainttype);
                            c.Parameters.AddWithValue("@st", status);
                            c.Parameters.AddWithValue("@ty", type);
                            c.Parameters.AddWithValue("@as", assignedto);
                            c.Parameters.AddWithValue("@amt", Dec(h["ntotalamount"]));
                            c.Parameters.AddWithValue("@no", PS(Cap(callno, 50)));
                            c.Parameters.AddWithValue("@rno", PS(Cap(trnno, 50)));
                            c.Parameters.AddWithValue("@pin", visitdt);
                            c.Parameters.AddWithValue("@pout", visitout);
                            c.Parameters.AddWithValue("@cc", ccode);
                            c.Parameters.AddWithValue("@p", productcode);
                            c.Parameters.AddWithValue("@sr", PS(Cap(serialno, 50)));
                            c.Parameters.AddWithValue("@cl", closedt);
                            c.Parameters.AddWithValue("@rem", PS(string.Join(" | ", rem)));
                            c.Parameters.AddWithValue("@cp", contactperson);
                            c.Parameters.AddWithValue("@cbr", cbranch);
                            c.Parameters.AddWithValue("@sc", PS(Str(h["vcomplaint"])));
                            c.Parameters.AddWithValue("@ob", PS(Str(h["vspecialinstructions"])));
                            c.Parameters.AddWithValue("@sd", PS(Str(h["vsolveremarks"])));
                            c.Parameters.AddWithValue("@cb", MigrationUser);
                            c.Parameters.AddWithValue("@con", createdon);
                            c.Parameters.AddWithValue("@uon", updatedon);
                            code = Convert.ToInt32(c.ExecuteScalar());
                        }
                    }

                    // ---- call visits (the app writes one on every save; eBizWiz keeps the real engineer visits) ----
                    int visitN = 0;
                    Dictionary<int, int> visitUser = new Dictionary<int, int>();
                    if (visits != null)
                        foreach (object[] v in visits)
                        {
                            int vsrc = (int)v[0];
                            int vu; object vby = UserByCode.TryGetValue((string)v[2], out vu) ? (object)vu : assignedto;
                            if (vby != DBNull.Value && vby != null) visitUser[vsrc] = Convert.ToInt32(vby);
                            List<string> vr = new List<string>();
                            string vt = (string)v[3]; if (vt.Length > 0) vr.Add("Visit No: " + vt);
                            string vrm = (string)v[4]; if (vrm.Length > 0) vr.Add(vrm);
                            string vcr = (string)v[5]; if (vcr.Length > 0) vr.Add("Customer Remarks: " + vcr);
                            string vpr = (string)v[6]; if (vpr.Length > 0) vr.Add("Parts Replaced: " + vpr);
                            string vpc = (string)v[7]; if (vpc.Length > 0) vr.Add("Person Contacted: " + vpc);
                            if ((decimal)v[8] != 0) vr.Add("Time Spent: " + ((decimal)v[8]).ToString("0.##", CultureInfo.InvariantCulture) + " hrs");
                            if ((int)v[9] != 0) vr.Add("Kms: " + (int)v[9]);
                            bool vsolved = false;
                            List<object[]> vf;
                            if (_faults.TryGetValue(key + "|" + vsrc, out vf))
                                foreach (object[] f in vf) { vr.Add(FaultText(f)); if ((bool)f[4]) vsolved = true; }
                            using (SqlCommand q = new SqlCommand(@"INSERT INTO callvisits (contractcallcode, date, complaint, status, type, assignedto, callamt, pmscomplaintno,
                                                                                          preferredtimein, ccode, productcode, closedt, remark, createdby, createdon, updatedby, updatedon)
                                                                   VALUES (@cc, @dt, @ct, @st, @ty, @as, 0, @no, @dt, @party, @p, @cl, @rem, @cb, @con, @cb, @uon)", tgt, tx))
                            {
                                q.Parameters.AddWithValue("@cc", code);
                                q.Parameters.AddWithValue("@dt", v[1]);
                                q.Parameters.AddWithValue("@ct", complainttype);
                                q.Parameters.AddWithValue("@st", vsolved ? _stClosed : status);
                                q.Parameters.AddWithValue("@ty", isUpdate ? "PMS" : type);
                                q.Parameters.AddWithValue("@as", vby);
                                q.Parameters.AddWithValue("@no", PS(Cap(callno, 50)));
                                q.Parameters.AddWithValue("@party", ccode);
                                q.Parameters.AddWithValue("@p", productcode);
                                q.Parameters.AddWithValue("@cl", vsolved ? v[1] : DBNull.Value);
                                q.Parameters.AddWithValue("@rem", PS(string.Join(" | ", vr)));
                                q.Parameters.AddWithValue("@cb", MigrationUser);
                                q.Parameters.AddWithValue("@con", v[1]);
                                q.Parameters.AddWithValue("@uon", v[1]);
                                q.ExecuteNonQuery();
                            }
                            visitN++;
                        }

                    // ---- spares -> amcusedproduct (Used Product tab) ----
                    int partN = 0; List<object[]> stockLines = new List<object[]>();
                    if (parts != null)
                        foreach (object[] p in parts)
                        {
                            int ppc; if (!_prodByItem.TryGetValue((int)p[1], out ppc)) { _skipParts++; continue; }
                            int vu2; object pexec = visitUser.TryGetValue((int)p[0], out vu2) ? (object)vu2 : assignedto;
                            int un; object unit = _unitByProd.TryGetValue(ppc, out un) && un > 0 ? (object)un : DBNull.Value;
                            decimal qty = (decimal)p[2];
                            List<string> prr = new List<string>();
                            string sl = (string)p[6]; if (sl.Length > 0) prr.Add("Spare Location: " + sl);
                            if ((decimal)p[3] != 0) prr.Add("Defective Qty: " + ((decimal)p[3]).ToString("0.##", CultureInfo.InvariantCulture));
                            if ((bool)p[5]) prr.Add("Claimed");
                            string prm = (string)p[7]; if (prm.Length > 0) prr.Add(prm);
                            using (SqlCommand q = new SqlCommand(@"INSERT INTO amcusedproduct (complaintcode, pcode, qty, unit, executive, quotationcost, remark, serialno, createdby, createdon, updatedby, updatedon)
                                                                   VALUES (@c, @p, @q, @u, @e, @cost, @rem, @sr, @cb, @con, @cb, @uon)", tgt, tx))
                            {
                                q.Parameters.AddWithValue("@c", code);
                                q.Parameters.AddWithValue("@p", ppc);
                                q.Parameters.AddWithValue("@q", qty);
                                q.Parameters.AddWithValue("@u", unit);
                                q.Parameters.AddWithValue("@e", pexec);
                                q.Parameters.AddWithValue("@cost", (decimal)p[4]);
                                q.Parameters.AddWithValue("@rem", PS(Cap(string.Join(" | ", prr), 500)));          // nvarchar(1000) = 500 characters - Aftab Alam
                                q.Parameters.AddWithValue("@sr", PS(Cap(serialno, 50)));
                                q.Parameters.AddWithValue("@cb", MigrationUser);
                                q.Parameters.AddWithValue("@con", createdon);
                                q.Parameters.AddWithValue("@uon", updatedon);
                                q.ExecuteNonQuery();
                            }
                            partN++;
                            // Only real stock items leave the store. 6,706 of the 6,858 eBizWiz "spares" are LABOUR rows (service charges);
                            // EdifyBiz keeps no stock for service products, so they stay in Used Product only - like module 8 (D3 SAL). - Aftab Alam
                            if (qty != 0 && !_serviceProd.Contains(ppc)) stockLines.Add(new object[] { ppc, qty, (decimal)p[4] });
                        }

                    // ---- pending parts -> amcrequestedproduct (Requested Product tab) ----
                    int reqN = 0;
                    if (pend != null)
                        foreach (object[] p in pend)
                        {
                            int ppc; if (!_prodByItem.TryGetValue((int)p[0], out ppc)) continue;
                            int un; object unit = _unitByProd.TryGetValue(ppc, out un) && un > 0 ? (object)un : DBNull.Value;
                            using (SqlCommand q = new SqlCommand(@"INSERT INTO amcrequestedproduct (complaintcode, pcode, qty, unit, executive, remark, serialno, createdby, createdon, updatedby, updatedon)
                                                                   VALUES (@c, @p, @q, @u, @e, @rem, @sr, @cb, @con, @cb, @uon)", tgt, tx))
                            {
                                q.Parameters.AddWithValue("@c", code);
                                q.Parameters.AddWithValue("@p", ppc);
                                q.Parameters.AddWithValue("@q", (decimal)p[1]);
                                q.Parameters.AddWithValue("@u", unit);
                                q.Parameters.AddWithValue("@e", assignedto);
                                q.Parameters.AddWithValue("@rem", PS(Cap((string)p[2], 500)));
                                q.Parameters.AddWithValue("@sr", PS(Cap(serialno, 50)));
                                q.Parameters.AddWithValue("@cb", MigrationUser);
                                q.Parameters.AddWithValue("@con", createdon);
                                q.Parameters.AddWithValue("@uon", updatedon);
                                q.ExecuteNonQuery();
                            }
                            reqN++;
                        }

                    // ---- check list -> taskchecklist (module 'ACM'), same standard component as SO / CQ / SAL ----
                    int checkN = 0, sort = 1;
                    if (checks != null)
                        foreach (object[] k in checks)
                        {
                            string title = LookInt(_checkName, (int)k[0]); if (title.Length == 0) continue;
                            bool done = (bool)k[2];
                            object duedate = k[1] != DBNull.Value ? k[1] : (done && k[3] != DBNull.Value ? k[3] : createdon);
                            int au; object assign = UserByCode.TryGetValue((string)k[4], out au) ? (object)au : assignedto;
                            using (SqlCommand q = new SqlCommand(@"INSERT INTO taskchecklist (title, status, module, modulecode, duedate, assignto, remark, sort, createdby, updatedby, createdon, updatedon)
                                                                   VALUES (@t, @s, 'ACM', @mc, @dd, @at, @rm, @sr, @cb, @cb, @con, @uon)", tgt, tx))
                            {
                                q.Parameters.AddWithValue("@t", Cap(title, 500));
                                q.Parameters.AddWithValue("@s", done ? 1 : 0);
                                q.Parameters.AddWithValue("@mc", code);
                                q.Parameters.AddWithValue("@dd", duedate);
                                q.Parameters.AddWithValue("@at", assign);
                                q.Parameters.AddWithValue("@rm", PS((string)k[5]));
                                q.Parameters.AddWithValue("@sr", sort++);
                                q.Parameters.AddWithValue("@cb", MigrationUser);
                                q.Parameters.AddWithValue("@con", createdon);
                                q.Parameters.AddWithValue("@uon", done && k[3] != DBNull.Value ? k[3] : updatedon);
                                q.ExecuteNonQuery();
                            }
                            checkN++;
                        }

                    // ---- labels (category 'AMC'): the eBizWiz call type, + Warranty Void ----
                    int labelN = 0;
                    labelN += AddLabel(tgt, tx, code, calltype, createdon);
                    if (Bool(h["bwvoid"])) labelN += AddLabel(tgt, tx, code, "Warranty Void", createdon);

                    // ---- spares leave the branch: one MRO + ledger, so stock matches eBizWiz (D1) ----
                    int mroLines = 0; bool mroMade = false;
                    int branch;
                    if (stockLines.Count > 0 && _branchByOffice.TryGetValue(office, out branch))
                    {
                        object sdate = calldate.HasValue ? (object)calldate.Value : createdon;
                        int sio;
                        using (SqlCommand c = new SqlCommand(@"INSERT INTO stockinout (number, date, branchcode, type, remark, createdby, createdon, updatedby, updatedon)
                                                               OUTPUT INSERTED.code VALUES (@no, @dt, @br, 'MRO', @rem, @cb, @dt, @cb, @dt)", tgt, tx))
                        {
                            c.Parameters.AddWithValue("@no", Cap(callno, 30));
                            c.Parameters.AddWithValue("@dt", sdate);
                            c.Parameters.AddWithValue("@br", branch);
                            c.Parameters.AddWithValue("@rem", PS(Cap("Spares used on service call " + callno + (calltype.Length > 0 ? " (" + calltype + ")" : ""), 1000)));
                            c.Parameters.AddWithValue("@cb", MigrationUser);
                            sio = Convert.ToInt32(c.ExecuteScalar());
                        }
                        foreach (object[] l in stockLines)
                        {
                            int lpc = (int)l[0]; decimal lq = (decimal)l[1];
                            int bt; object batch = _batchByProd.TryGetValue(lpc, out bt) ? (object)bt : DBNull.Value;
                            int un; object unit = _unitByProd.TryGetValue(lpc, out un) && un > 0 ? (object)un : DBNull.Value;
                            int detCode;
                            using (SqlCommand d = new SqlCommand(@"INSERT INTO stockinoutdet (stockinoutcode, productcode, prodbatchcode, qty, dqty, unit, price, createdby, createdon, updatedby, updatedon)
                                                                   OUTPUT INSERTED.code VALUES (@p, @pc, @b, @q, 0, @u, @pr, @cb, @dt, @cb, @dt)", tgt, tx))
                            {
                                d.Parameters.AddWithValue("@p", sio); d.Parameters.AddWithValue("@pc", lpc); d.Parameters.AddWithValue("@b", batch);
                                d.Parameters.AddWithValue("@q", lq); d.Parameters.AddWithValue("@u", unit); d.Parameters.AddWithValue("@pr", (decimal)l[2]);
                                d.Parameters.AddWithValue("@cb", MigrationUser); d.Parameters.AddWithValue("@dt", sdate);
                                detCode = Convert.ToInt32(d.ExecuteScalar());
                            }
                            using (SqlCommand s = new SqlCommand(@"INSERT INTO stocktrans (date, branchcode, productcode, prodbatchcode, qty, dqty, unit, module, modulecode, createdby, createdon, updatedby, updatedon)
                                                                   VALUES (@dt, @br, @pc, @b, @q, 0, @u, 'MRO', @mc, @cb, @dt, @cb, @dt)", tgt, tx))
                            {
                                s.Parameters.AddWithValue("@dt", sdate); s.Parameters.AddWithValue("@br", branch); s.Parameters.AddWithValue("@pc", lpc);
                                s.Parameters.AddWithValue("@b", batch); s.Parameters.AddWithValue("@q", -lq); s.Parameters.AddWithValue("@u", unit);
                                s.Parameters.AddWithValue("@mc", detCode); s.Parameters.AddWithValue("@cb", MigrationUser);
                                s.ExecuteNonQuery();
                            }
                            mroLines++;
                        }
                        mroMade = true;
                    }

                    tx.Commit();
                    _rows++; if (isUpdate) _upd++; else _new++;
                    if (!isUpdate) { if (type == "PMS") _pms++; else if (type == "Walk In") _walkin++; }
                    if (det != null) _detLinked++;
                    _visitN += visitN; _partN += partN; _reqN += reqN; _checkN += checkN; _labelN += labelN;
                    if (mroMade) { _mro++; _mroLines += mroLines; }
                    if (_rows % 2000 == 0) Console.WriteLine("  ... " + _rows + " calls migrated");
                }
                catch { tx.Rollback(); throw; }
            }
        }

        // ---------- helpers ----------
        static string FaultText(object[] f)
        {
            List<string> p = new List<string>();
            string c = LookInt(_complaintName, (int)f[0]); if (c.Length > 0) p.Add("Complaint: " + c);
            string d = LookInt(_defect, (int)f[1]); if (d.Length > 0) p.Add("Defect: " + d);
            string r = LookInt(_repair, (int)f[2]); if (r.Length > 0) p.Add("Repair: " + r);
            string rm = (string)f[3]; if (rm.Length > 0) p.Add(rm);
            return string.Join(", ", p);
        }

        // eBizWiz call type -> the four values our form and list filter know. Without a contract line only Walk In
        // shows the product / serial on the form (getallhtml builds the dropdowns from the customer's contracts).
        static string TypeOf(string calltype, bool hasDet)
        {
            if (!hasDet) return "Walk In";
            string n = (calltype ?? "").ToUpperInvariant().Replace(" ", "");
            if (n.Contains("PMVISIT")) return "PMS";
            if (n.Contains("INSTALLATION")) return "Installation";
            return "Complaint";
        }

        // The serial's contract line = the one whose period covers the call date (a call is "under" a warranty / AMC only while
        // it runs). An INSTALLATION call may come before the start - warranty usually starts at installation - so it takes the
        // line of that serial starting soonest after the call. Otherwise no line -> Walk In. The earlier fallback ("latest line
        // starting before the call") tied 4,000+ breakdown calls to warranties / AMCs that had already expired. PM VISIT calls
        // on a schedule never come here: they update their own PMS row. - Aftab Alam
        static Det ResolveDet(string serialKey, DateTime? d, bool installation)
        {
            List<Det> list;
            if (serialKey.Length == 0 || !_detBySerial.TryGetValue(serialKey, out list) || list.Count == 0 || !d.HasValue) return null;
            DateTime day = d.Value.Date;
            foreach (Det x in list) if (x.Start.HasValue && x.Start.Value.Date <= day && (!x.End.HasValue || x.End.Value.Date >= day)) return x;
            if (installation)
            {
                Det next = null;
                foreach (Det x in list) if (x.Start.HasValue && x.Start.Value.Date > day && (next == null || x.Start.Value < next.Start.Value)) next = x;
                return next;
            }
            return null;
        }

        static Det ResolveDetOld(string serialKey, DateTime? d)
        {
            List<Det> list;
            if (serialKey.Length == 0 || !_detBySerial.TryGetValue(serialKey, out list) || list.Count == 0) return null;
            if (d.HasValue)
            {
                foreach (Det x in list) if (x.Start.HasValue && x.Start.Value <= d.Value && (!x.End.HasValue || x.End.Value >= d.Value)) return x;
                Det best = null;
                foreach (Det x in list) if (x.Start.HasValue && x.Start.Value <= d.Value && (best == null || x.Start.Value > best.Start.Value)) best = x;
                if (best != null) return best;
            }
            return list[list.Count - 1];
        }

