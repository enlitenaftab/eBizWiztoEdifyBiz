                int detnc = Int(r[7]);
                if (detnc > 0)
                {
                    List<int> links;
                    if (!_soLinksByPO.TryGetValue(key, out links)) { links = new List<int>(); _soLinksByPO[key] = links; }
                    if (!links.Contains(detnc)) links.Add(detnc);
