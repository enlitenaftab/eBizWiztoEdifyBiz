                l.Add(new object[] { Int(r["ncalls1"]), Int(r["nitem"]), Dec(r["nquantity"]), Dec(r["ndefqty"]), Dec(r["nrate"]), Bool(r["bclaimed"]), Str(r["vsparelocation"]), Str(r["vremarks"]) });
                p++;
            }
            // check list: { 0 check, 1 expdate, 2 done, 3 donedate, 4 allottedKey, 5 remark }
            int c = 0;
            foreach (DataRow r in GetSrc(@"SELECT nofficeid, ncalls, ncheck, dexpdate, bdone, ddonedate, nallotedto, vremarks
                                           FROM trdcalls8checks WITH (NOLOCK) WHERE nofficeid IN (" + OfficeIn + ") ORDER BY nofficeid, ncalls, ncode").Tables[0].Rows)
            {
                string k = Int(r["nofficeid"]) + "|" + Int(r["ncalls"]);
                List<object[]> l; if (!_checks.TryGetValue(k, out l)) _checks[k] = l = new List<object[]>();
                l.Add(new object[] { Int(r["ncheck"]), P(r["dexpdate"]), Bool(r["bdone"]), P(r["ddonedate"]), NKey(r["nallotedto"]), Str(r["vremarks"]) });
                c++;
            }
            // pending parts: { 0 item, 1 qty, 2 remark }
            int pp = 0;
            foreach (DataRow r in GetSrc("SELECT nofficeid, ncalls, nitem, nquantity, vremarks FROM trdcalls10pendingparts WITH (NOLOCK) WHERE nofficeid IN (" + OfficeIn + ")").Tables[0].Rows)
            {
                string k = Int(r["nofficeid"]) + "|" + Int(r["ncalls"]);
                List<object[]> l; if (!_pending.TryGetValue(k, out l)) _pending[k] = l = new List<object[]>();
                l.Add(new object[] { Int(r["nitem"]), Dec(r["nquantity"]), Str(r["vremarks"]) });
