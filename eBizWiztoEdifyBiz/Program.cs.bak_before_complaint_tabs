        // GST rate from a charge label: "NIL" labels ("GST : NIL for 100% EOU against Form A") and anything above 28% are not a rate -> 0.
        public static decimal GstRateIn(string label)
        {
            if ((label ?? "").IndexOf("NIL", StringComparison.OrdinalIgnoreCase) >= 0) return 0m;
            decimal r = PercentIn(label);
            return r > 28m ? 0m : r;
        }

        // First "<number>%" in a label, e.g. "Add : CGST @9%" -> 9, "18% IGST" -> 18. 0 when none.
        // eBizWiz Master > Office (mstoffice: address, postal code, telephone 1/2, fax, email, website, zone, remarks) -> the branch's
        // standard EdifyBiz Company > Address fields (companyaddress). Only EMPTY target fields are filled, nothing is overwritten.
        // City / state stay as set by EnsureGstSetup (every Saksham office bills on the Maharashtra GSTIN). - Aftab Alam
        public static void FillBranchDetails(SqlConnection tgt)
        {
            Dictionary<int, string> zone = new Dictionary<int, string>();
            foreach (DataRow r in GetSrc("SELECT ncode, vname FROM mstzones WITH (NOLOCK)").Tables[0].Rows) zone[Int(r["ncode"])] = Str(r["vname"]);
            // Master > Office > Office Type -> standard Company Address "Office Type" dropdown (miscellaneous module BDS, type Office Type;
            // companyaddress.type = its code): every active client type + any used by an office in scope, matched by name. - Aftab Alam
            Dictionary<int, int> typeMap = new Dictionary<int, int>(); int typesAdded = 0;
            foreach (DataRow r in GetSrc("SELECT ncode, vname FROM mstofficetype WITH (NOLOCK) WHERE bactive = 1 OR ncode IN (SELECT nofficetype FROM mstoffice WITH (NOLOCK) WHERE ncode IN (" + OfficeIn + "))").Tables[0].Rows)
            {
                string nm = Str(r["vname"]); if (nm.Length == 0) continue;
                object o;
                using (SqlCommand q = new SqlCommand("SELECT TOP 1 code FROM miscellaneous WHERE module = 'BDS' AND type = 'Office Type' AND name = @n ORDER BY code", tgt)) { q.Parameters.AddWithValue("@n", nm); o = q.ExecuteScalar(); }
                if (o == null || o == DBNull.Value)
                    using (SqlCommand ins = new SqlCommand("INSERT INTO miscellaneous (module, type, name, active, makedefault, createdby, createdon, updatedby, updatedon) OUTPUT INSERTED.code VALUES ('BDS', 'Office Type', @n, 1, 0, @cb, GETDATE(), @cb, GETDATE())", tgt))
                    { ins.Parameters.AddWithValue("@n", nm); ins.Parameters.AddWithValue("@cb", MigrationUser); o = ins.ExecuteScalar(); typesAdded++; }
                typeMap[Int(r["ncode"])] = Convert.ToInt32(o);
            }
            Console.WriteLine("  miscellaneous(BDS/Office Type) seeded: " + typesAdded);
            int n = 0;
            foreach (DataRow r in GetSrc("SELECT ncode, vcompanyname, vaddress, vpostalcode, vtel1, vtel2, vfax, vemail, vwebsite, vremarks, nzone, nofficetype FROM mstoffice WITH (NOLOCK) WHERE ncode IN (" + OfficeIn + ")").Tables[0].Rows)
            {
                string z; zone.TryGetValue(Int(r["nzone"]), out z);
                // telephone columns are 20 chars; "022 28443636 / 28891439" -> telephone2 + telephone3
                string t1 = Str(r["vtel1"]), t2 = Str(r["vtel2"]), t3 = "";
                if (t2.Length > 20 && t2.Contains("/")) { t3 = t2.Substring(t2.IndexOf('/') + 1).Trim(); t2 = t2.Substring(0, t2.IndexOf('/')).Trim(); }
                using (SqlCommand u = new SqlCommand(@"UPDATE companyaddress SET
                        address    = CASE WHEN ISNULL(address,'')    = '' THEN @a  ELSE address    END,
                        pincode    = CASE WHEN ISNULL(pincode,'')    = '' THEN @pc ELSE pincode    END,
                        telephone1 = CASE WHEN ISNULL(telephone1,'') = '' THEN @t1 ELSE telephone1 END,
                        telephone2 = CASE WHEN ISNULL(telephone2,'') = '' THEN @t2 ELSE telephone2 END,
                        telephone3 = CASE WHEN ISNULL(telephone3,'') = '' THEN @t3 ELSE telephone3 END,
                        fax1       = CASE WHEN ISNULL(fax1,'')       = '' THEN @fx ELSE fax1       END,
                        email1     = CASE WHEN ISNULL(email1,'')     = '' THEN @em ELSE email1     END,
                        website1   = CASE WHEN ISNULL(website1,'')   = '' THEN @wb ELSE website1   END,
                        zone       = CASE WHEN ISNULL(zone,'')       = '' THEN @z  ELSE zone       END,
                        remark     = CASE WHEN ISNULL(remark,'')     = '' THEN @rm ELSE remark     END,
                        type       = ISNULL(type, @ty),
                        updatedby = @cb, updatedon = GETDATE()
                    WHERE ccode = @cc AND place = @pl", tgt))
                {
                    u.Parameters.AddWithValue("@a", PS(Str(r["vaddress"]))); u.Parameters.AddWithValue("@pc", PS(Cap(Str(r["vpostalcode"]), 10)));
                    u.Parameters.AddWithValue("@t1", PS(Cap(t1, 20))); u.Parameters.AddWithValue("@t2", PS(Cap(t2, 20))); u.Parameters.AddWithValue("@t3", PS(Cap(t3, 20)));
                    u.Parameters.AddWithValue("@fx", PS(Cap(Str(r["vfax"]), 20))); u.Parameters.AddWithValue("@em", PS(Str(r["vemail"])));
                    u.Parameters.AddWithValue("@wb", PS(Str(r["vwebsite"]))); u.Parameters.AddWithValue("@z", PS(z ?? ""));
                    int ty; u.Parameters.AddWithValue("@ty", typeMap.TryGetValue(Int(r["nofficetype"]), out ty) ? (object)ty : DBNull.Value);
                    u.Parameters.AddWithValue("@rm", PS(Str(r["vremarks"]))); u.Parameters.AddWithValue("@cb", MigrationUser);
                    u.Parameters.AddWithValue("@cc", CompanyCode); u.Parameters.AddWithValue("@pl", Cap(Str(r["vcompanyname"]), 100));
                    n += u.ExecuteNonQuery();
                }
            }
            Console.WriteLine("  Branch details (address / phones / email / website / zone / office type) filled from eBizWiz offices: " + n);
        }

        // Closing stock = the client's own balance. eBizWiz keeps the current stock per office + item in mststkdt (ngoodbal / ndefbal) and
        // lets users change it directly (Stock > Change Stock Details) without any transaction, so opening + in - out - sold - spares
        // differs from it on ~2,500 items (e.g. Cryo Box 2 Inch HO: 1,581 received, nothing issued, balance 0). After every stock
        // movement is posted (modules 8 and 11) one EdifyBiz stock JV per branch + product carries the difference - the same standard
        // entry as Opening Stock (stockjv module JV + stocktrans JV, app/inventory/openingstock.asp -> InventoryTrigger), remark
        // "eBizWiz balance adjustment", dated when the client last changed that balance (mststkdt.editedon). Service products hold no
        // stock and are skipped. Re-run safe: an existing adjustment row of the branch + product is left as it is. - Aftab Alam
        public static void PostBalanceAdjustment(SqlConnection tgt, Dictionary<int, int> branchByOffice, Dictionary<int, int> prodByItem)
        {
            Dictionary<int, int> batchByProd = DefaultBatchByProduct();
            HashSet<int> service = new HashSet<int>();
            Dictionary<int, int> unitByProd = new Dictionary<int, int>();
            foreach (DataRow r in GetTgt("SELECT code, ISNULL(type,'p') AS t, ISNULL(unitcode,0) AS u FROM product WITH (NOLOCK)").Tables[0].Rows)
            { if (Str(r["t"]).ToLowerInvariant() == "s") service.Add(Int(r["code"])); unitByProd[Int(r["code"])] = Int(r["u"]); }
            Dictionary<string, decimal[]> ledger = new Dictionary<string, decimal[]>();
            foreach (DataRow r in GetTgt("SELECT branchcode, productcode, prodbatchcode, SUM(qty) q, SUM(dqty) dq FROM stocktrans WITH (NOLOCK) GROUP BY branchcode, productcode, prodbatchcode").Tables[0].Rows)
                ledger[Int(r["branchcode"]) + "|" + Int(r["productcode"]) + "|" + Int(r["prodbatchcode"])] = new decimal[] { Dec(r["q"]), Dec(r["dq"]) };
            HashSet<string> done = new HashSet<string>();
            foreach (DataRow r in GetTgt("SELECT branchcode, productcode, prodbatchcode FROM stockjv WHERE module = 'JV' AND remark = 'eBizWiz balance adjustment'").Tables[0].Rows)
                done.Add(Int(r["branchcode"]) + "|" + Int(r["productcode"]) + "|" + Int(r["prodbatchcode"]));

            int rows = 0, skipped = 0; decimal plus = 0, minus = 0, dplus = 0, dminus = 0;
            foreach (DataRow r in GetSrc("SELECT nofficeid, nitem, SUM(ISNULL(ngoodbal,0)) g, SUM(ISNULL(ndefbal,0)) d, MAX(editedon) ed, MAX(addedon) ad FROM mststkdt WITH (NOLOCK) WHERE nofficeid IN (" + OfficeIn + ") GROUP BY nofficeid, nitem ORDER BY nofficeid, nitem").Tables[0].Rows)
            {
                int br, prod, batch;
                if (!branchByOffice.TryGetValue(Int(r["nofficeid"]), out br) || !prodByItem.TryGetValue(Int(r["nitem"]), out prod) || !batchByProd.TryGetValue(prod, out batch)) { skipped++; continue; }
                if (service.Contains(prod)) continue;
                string k = br + "|" + prod + "|" + batch;
                if (done.Contains(k)) continue;
                decimal[] l; if (!ledger.TryGetValue(k, out l)) l = new decimal[] { 0m, 0m };
                decimal dq = Dec(r["g"]) - l[0], ddq = Dec(r["d"]) - l[1];
                if (dq == 0 && ddq == 0) continue;
                object dt = r["ed"] != DBNull.Value ? r["ed"] : (r["ad"] != DBNull.Value ? r["ad"] : (object)DateTime.Today);
                int unit; unitByProd.TryGetValue(prod, out unit);
                int jv;
                using (SqlCommand c = new SqlCommand(@"INSERT INTO stockjv (date, branchcode, productcode, prodbatchcode, qty, dqty, module, modulecode, remark, unit, createdby, createdon, updatedby, updatedon, price, number)
                                                       OUTPUT INSERTED.code
                                                       VALUES (@d, @b, @p, @pb, @q, @dq, 'JV', 0, 'eBizWiz balance adjustment', @u, @cb, @d, @cb, @d, 0, '')", tgt))
                {
                    c.Parameters.AddWithValue("@d", dt); c.Parameters.AddWithValue("@b", br); c.Parameters.AddWithValue("@p", prod); c.Parameters.AddWithValue("@pb", batch);
                    c.Parameters.AddWithValue("@q", dq); c.Parameters.AddWithValue("@dq", ddq); c.Parameters.AddWithValue("@u", unit); c.Parameters.AddWithValue("@cb", MigrationUser);
                    jv = Convert.ToInt32(c.ExecuteScalar());
                }
                using (SqlCommand c = new SqlCommand(@"INSERT INTO stocktrans (date, branchcode, productcode, prodbatchcode, qty, dqty, unit, module, modulecode, createdby, createdon, updatedby, updatedon)
                                                       VALUES (@d, @b, @p, @pb, @q, @dq, @u, 'JV', @jv, @cb, @d, @cb, @d)", tgt))
                {
                    c.Parameters.AddWithValue("@d", dt); c.Parameters.AddWithValue("@b", br); c.Parameters.AddWithValue("@p", prod); c.Parameters.AddWithValue("@pb", batch);
                    c.Parameters.AddWithValue("@q", dq); c.Parameters.AddWithValue("@dq", ddq); c.Parameters.AddWithValue("@u", unit); c.Parameters.AddWithValue("@jv", jv); c.Parameters.AddWithValue("@cb", MigrationUser);
                    c.ExecuteNonQuery();
                }
                rows++; if (dq > 0) plus += dq; else minus += dq; if (ddq > 0) dplus += ddq; else dminus += ddq;
            }
            Console.WriteLine("  eBizWiz balance adjustment (JV): " + rows + " branch+item rows, good +" + plus.ToString("0.##", CultureInfo.InvariantCulture) + " / " + minus.ToString("0.##", CultureInfo.InvariantCulture) +
                              ", damaged +" + dplus.ToString("0.##", CultureInfo.InvariantCulture) + " / " + dminus.ToString("0.##", CultureInfo.InvariantCulture) + "  (skipped, item not migrated: " + skipped + ")");
        }

        // eBizWiz item -> EdifyBiz product for every document line. Module 2 creates one product per item (casno = Item Code,
        // name = Name). 1,732 client names are shared by 8,423 items (same model name, different Item Code), so the old name-only
        // match sent every line of such an item to the FIRST product of that name. Item Code is unique per item: match on
        // Item Code + Name, then Item Code, and Name only as the last resort. - Aftab Alam
        public static void MapItemsToProducts(Dictionary<int, int> map)
        {
            Dictionary<string, int> byPair = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
            Dictionary<string, int> byCode = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
            Dictionary<string, int> byName = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
            foreach (DataRow r in GetTgt("SELECT code, casno, name FROM product WITH (NOLOCK) ORDER BY isdeleted, code").Tables[0].Rows)
            {
                string cs = Str(r["casno"]), n = Str(r["name"]); int c = Int(r["code"]);
                if (cs.Length > 0 && !byPair.ContainsKey(cs + "|" + n)) byPair[cs + "|" + n] = c;
                if (cs.Length > 0 && !byCode.ContainsKey(cs)) byCode[cs] = c;
                if (n.Length > 0 && !byName.ContainsKey(n)) byName[n] = c;
            }
            foreach (DataRow r in GetSrc("SELECT ncode, vitemcode, vname FROM mstitems WITH (NOLOCK) WHERE nofficeid IN (" + OfficeIn + ")").Tables[0].Rows)
            {
                int nc = Int(r["ncode"]); if (map.ContainsKey(nc)) continue;
                string cs = Cap(Str(r["vitemcode"]), 50), n = Cap(Str(r["vname"]), 150); int c;
                if (cs.Length > 0 && byPair.TryGetValue(cs + "|" + n, out c)) map[nc] = c;
                else if (cs.Length > 0 && byCode.TryGetValue(cs, out c)) map[nc] = c;
                else if (n.Length > 0 && byName.TryGetValue(n, out c)) map[nc] = c;
            }
        }

        // eBizWiz check sets (mstcheckset + msdcheckset) = EdifyBiz Checklist Master (taskchecklistmaster + taskchecklistmasterdet:
        // title, days, sort - read by app/task.asp when a checklist template is applied). The document check items themselves are in
        // taskchecklist (Task Check List tab); the set name therefore no longer goes into any remark. Sets of offices 2/3/4/6 that are
        // active or used by a migrated document; office 1 test sets and unused inactive sets are left out. Idempotent by title. - Aftab Alam
        static bool _checklistMastersDone;
        public static void EnsureChecklistMasters()
        {
            if (_checklistMastersDone) return;
            Dictionary<int, string> checkName = SrcLookupInt("SELECT ncode, vname FROM mstchecks WITH (NOLOCK)");
            HashSet<string> have = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            foreach (DataRow r in GetTgt("SELECT title FROM taskchecklistmaster").Tables[0].Rows) have.Add(Str(r["title"]).Trim());
            string used = "SELECT ncheckset FROM trhinqry WHERE nofficeid IN (" + OfficeIn + ") UNION SELECT ncheckset FROM trhquote WHERE nofficeid IN (" + OfficeIn + ") UNION SELECT ncheckset FROM trhordrc WHERE nofficeid IN (" + OfficeIn + ")" +
                          " UNION SELECT ncheckset FROM trhordpl WHERE nofficeid IN (" + OfficeIn + ") UNION SELECT ncheckset FROM trhsales WHERE nofficeid IN (" + OfficeIn + ") UNION SELECT ncheckset FROM trhoffer WHERE nofficeid IN (" + OfficeIn + ")" +
                          " UNION SELECT ncheckset FROM trhcontr WHERE nofficeid IN (" + OfficeIn + ") UNION SELECT ncheckset FROM trhcalls WHERE nofficeid IN (" + OfficeIn + ")";
            DataTable sets = GetSrc("SELECT ncode, vname FROM mstcheckset WITH (NOLOCK) WHERE nofficeid IN (" + OfficeIn + ") AND (bactive = 1 OR ncode IN (" + used + ")) ORDER BY ncode").Tables[0];
            DataTable items = GetSrc("SELECT ncheckset, nchecks, ndisplayorder, ndaysdiff FROM msdcheckset WITH (NOLOCK) ORDER BY ncheckset, ndisplayorder, ncode").Tables[0];
            int added = 0, lines = 0;
            using (SqlConnection tgt = OpenTgt())
                foreach (DataRow st in sets.Rows)
                {
                    string title = Str(st["vname"]).Trim(); if (title.Length == 0 || have.Contains(title)) continue;
                    using (SqlTransaction tx = tgt.BeginTransaction())
                    {
                        int mcode;
                        using (SqlCommand c = new SqlCommand("INSERT INTO taskchecklistmaster (title, createdby, createdon, updatedby, updatedon) OUTPUT INSERTED.code VALUES (@t, @cb, GETDATE(), @cb, GETDATE())", tgt, tx))
                        { c.Parameters.AddWithValue("@t", title); c.Parameters.AddWithValue("@cb", MigrationUser); mcode = Convert.ToInt32(c.ExecuteScalar()); }
                        int sort = 0;
                        foreach (DataRow it in items.Select("ncheckset = " + Int(st["ncode"])))
                        {
                            string nm = LookInt(checkName, Int(it["nchecks"])).Trim(); if (nm.Length == 0) nm = "Check " + Int(it["nchecks"]);
                            using (SqlCommand d = new SqlCommand("INSERT INTO taskchecklistmasterdet (taskchecklistmastercode, title, days, sort, createdby, createdon, updatedby, updatedon) VALUES (@m, @t, @d, @s, @cb, GETDATE(), @cb, GETDATE())", tgt, tx))
                            { d.Parameters.AddWithValue("@m", mcode); d.Parameters.AddWithValue("@t", nm); d.Parameters.AddWithValue("@d", Int(it["ndaysdiff"])); d.Parameters.AddWithValue("@s", sort++); d.Parameters.AddWithValue("@cb", MigrationUser); d.ExecuteNonQuery(); }
                            lines++;
                        }
                        tx.Commit(); have.Add(title); added++;
                    }
                }
            Console.WriteLine("  Checklist Master (taskchecklistmaster): " + added + " sets, " + lines + " items seeded from eBizWiz check sets");
            _checklistMastersDone = true;
        }

        public static decimal PercentIn(string label)
        {
            System.Text.RegularExpressions.Match m = System.Text.RegularExpressions.Regex.Match(label ?? "", @"(\d+(?:\.\d+)?)\s*%");
            decimal d;
            return m.Success && decimal.TryParse(m.Groups[1].Value, NumberStyles.Number, CultureInfo.InvariantCulture, out d) ? d : 0m;
        }
    }

