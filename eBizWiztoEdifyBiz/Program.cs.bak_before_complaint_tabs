        // Migrate ALL source users so every salesperson resolves to a real user (not Admin).
        static void EnsureUsers(SqlConnection tgt)
        {
            HashSet<string> usedUsernames = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            HashSet<string> createdNames = new HashSet<string>();
            using (SqlCommand c = new SqlCommand("SELECT code, name, username FROM users", tgt))
            using (SqlDataReader r = c.ExecuteReader())
                while (r.Read())
                {
                    string nm = Str(r["name"]); if (nm.Length > 0 && !_userByName.ContainsKey(nm)) _userByName[nm] = Int(r["code"]);
                    string un = Str(r["username"]); if (un.Length > 0) usedUsernames.Add(un);
                }

            int tmplCompcode = 0, tmplRole = 0; string tmplPass = "";
            using (SqlCommand c = new SqlCommand("SELECT compcode, role, password FROM users WHERE code=@c", tgt))
            {
                c.Parameters.AddWithValue("@c", MigrationUser);
                using (SqlDataReader r = c.ExecuteReader())
                    if (r.Read()) { tmplCompcode = Int(r["compcode"]); tmplRole = Int(r["role"]); tmplPass = Str(r["password"]); }
            }

            int created = 0;
            foreach (KeyValuePair<string, string> kv in _users)
            {
                string nm = (kv.Value ?? "").Trim();
                if (nm.Length == 0) continue;
                if (nm.Length > 150) nm = nm.Substring(0, 150);
                if (_userByName.ContainsKey(nm)) continue;

                string baseun = new string(nm.Where(char.IsLetterOrDigit).ToArray());
                if (baseun.Length == 0) baseun = "user";
                if (baseun.Length > 40) baseun = baseun.Substring(0, 40);
                string un = baseun; int seq = 2;
                while (usedUsernames.Contains(un)) { un = baseun + seq; seq++; }
                usedUsernames.Add(un);

                using (SqlCommand ins = new SqlCommand(@"INSERT INTO users (name, username, password, compcode, role, createdby, createdon, updatedby, updatedon)
                                         OUTPUT INSERTED.code VALUES (@n, @un, @pw, @cc, @rl, @cb, GETDATE(), @cb, GETDATE())", tgt))
                {
                    ins.Parameters.AddWithValue("@n", nm);
                    ins.Parameters.AddWithValue("@un", un);
                    ins.Parameters.AddWithValue("@pw", PS(tmplPass));
                    ins.Parameters.AddWithValue("@cc", tmplCompcode == 0 ? (object)DBNull.Value : tmplCompcode);
                    ins.Parameters.AddWithValue("@rl", tmplRole == 0 ? (object)DBNull.Value : tmplRole);
                    ins.Parameters.AddWithValue("@cb", MigrationUser);
                    int code = Convert.ToInt32(ins.ExecuteScalar());
                    _userByName[nm] = code; created++;
                    createdNames.Add(nm);
                }
            }
            // Master > Users and Rights: a client user who is inactive in eBizWiz (no active mstusers row with that name) gets the
            // standard EdifyBiz suspend flag (users.suspenduser = 1 -> login refused "account has been suspended"); mobile and postal
            // code go to users.mobile_no / zipcode. Only users created by the migration are touched. - Aftab Alam
            Dictionary<string, object[]> det = new Dictionary<string, object[]>(StringComparer.OrdinalIgnoreCase);   // name -> { active, mobile, zip }
            foreach (DataRow r in GetSrc("SELECT vname, bactive, vmobile, vpostalcode FROM mstusers WITH (NOLOCK) ORDER BY bactive DESC, ncode").Tables[0].Rows)
            {
                string nm = Cap(Str(r["vname"]), 150); if (nm.Length == 0) continue;
                object[] d; if (!det.TryGetValue(nm, out d)) det[nm] = d = new object[] { false, "", "" };
                if (Bool(r["bactive"])) d[0] = true;
                if (((string)d[1]).Length == 0) d[1] = Cap(Str(r["vmobile"]), 50);
                if (((string)d[2]).Length == 0) d[2] = Str(r["vpostalcode"]);
            }
            int suspended = 0;
            foreach (string nm in createdNames)
            {
                object[] d; if (!det.TryGetValue(nm, out d)) continue;
                using (SqlCommand u = new SqlCommand("UPDATE users SET suspenduser = @s, mobile_no = ISNULL(NULLIF(mobile_no,''), @m), zipcode = ISNULL(NULLIF(zipcode,''), @z) WHERE code = @c", tgt))
                {
                    u.Parameters.AddWithValue("@s", (bool)d[0] ? 0 : 1); u.Parameters.AddWithValue("@m", PS((string)d[1])); u.Parameters.AddWithValue("@z", PS((string)d[2]));
                    u.Parameters.AddWithValue("@c", _userByName[nm]); u.ExecuteNonQuery();
                }
                if (!(bool)d[0]) suspended++;
            }
            Console.WriteLine("  Users inactive in eBizWiz -> suspended: " + suspended);
            Console.WriteLine("  Users (ALL source users): " + _userByName.Count + " in target, " + created + " created.");
        }

        // users.companybranch = the branches a user may see. Sales Invoice, GRN / MRO / GTA lists (and their views) filter
        // "branchcode in (users.companybranch)", so a migrated user with NULL saw none of the migrated documents and Admin
        // ("1, 2") none of branches 3-6. Source = the client's own user-office access (msduseroffice) + the user's office;
        // Admin (migration user) gets every migrated branch. Existing values are kept and only missing branches added,
        // in the app's "1, 2" format. - Aftab Alam
        static void AssignUserBranches(SqlConnection tgt)
        {
            EnsureUserByCode();
            Dictionary<int, SortedSet<int>> byUser = new Dictionary<int, SortedSet<int>>();
            Action<int, int> add = (u, office) => { int br; if (u <= 0 || !_branchByOffice.TryGetValue(office, out br)) return; SortedSet<int> s; if (!byUser.TryGetValue(u, out s)) byUser[u] = s = new SortedSet<int>(); s.Add(br); };
            foreach (DataRow r in GetSrc("SELECT nuser, noffice FROM msduseroffice WITH (NOLOCK)").Tables[0].Rows)
            { int u; if (UserByCode.TryGetValue(NKey(r["nuser"]), out u)) add(u, Int(r["noffice"])); }
            foreach (DataRow r in GetSrc("SELECT ncode, nofficeid FROM mstusers WITH (NOLOCK)").Tables[0].Rows)
            { int u; if (UserByCode.TryGetValue(NKey(r["ncode"]), out u)) add(u, Int(r["nofficeid"])); }
            foreach (int br in _branchByOffice.Values) add(MigrationUser, _branchByOffice.First(kv => kv.Value == br).Key);

            int updated = 0;
            foreach (KeyValuePair<int, SortedSet<int>> kv in byUser)
            {
                SortedSet<int> all = new SortedSet<int>(kv.Value);
                string existing = "";
                using (SqlCommand q = new SqlCommand("SELECT ISNULL(companybranch,'') FROM users WHERE code=@c", tgt))
                { q.Parameters.AddWithValue("@c", kv.Key); object o = q.ExecuteScalar(); existing = o == null ? "" : Convert.ToString(o); }
                foreach (string part in existing.Split(',')) { int b; if (int.TryParse(part.Trim(), out b)) all.Add(b); }
                string value = string.Join(", ", all);
                if (value == existing.Trim()) continue;
                using (SqlCommand u = new SqlCommand("UPDATE users SET companybranch=@v WHERE code=@c", tgt))
                { u.Parameters.AddWithValue("@v", value); u.Parameters.AddWithValue("@c", kv.Key); u.ExecuteNonQuery(); }
                updated++;
            }
            Console.WriteLine("  User branch access (users.companybranch): " + updated + " users updated from msduseroffice");
        }

