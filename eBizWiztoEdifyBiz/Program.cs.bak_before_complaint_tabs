        static readonly Dictionary<string, object[]> _serialByLine = new Dictionary<string, object[]>();   // office|line ncode -> { serialsCsv, warrantymonths, installdate, location }
        static readonly Dictionary<string, List<string>> _serialTextByLine = new Dictionary<string, List<string>>();   // office|line ncode -> one text per serial (prod_desc)
        // Payment Terms (trdsales3payterms), Terms & Cond. set, Check List set, Sales Source names. - Aftab Alam
        static Dictionary<int, string> _termset, _checkset, _payTermName, _salesSource;
