        // eBizWiz Exchange Rate (mstexchangerate + msdexchangerate: currency, value, exchange currency, rate, effective from) ->
        // EdifyBiz standard Master > Currency Conversion (currencyconversion: name = currency short name, rate = INR for 1 unit;
        // inquiry lists convert price x qty x rate). The master keeps one rate per currency, so the latest effective rate to INR
        // of each currency is written; the dated history stays in eBizWiz. - Aftab Alam
        static void SeedCurrencyConversion(SqlConnection tgt)
        {
            int inrSrc = 0;
            foreach (DataRow r in GetSrc("SELECT ncode FROM mstcurrency WITH (NOLOCK) WHERE vmajorshortname = 'INR'").Tables[0].Rows) { inrSrc = Int(r["ncode"]); break; }
            if (inrSrc == 0) { Console.WriteLine("  currencyconversion: INR not found in eBizWiz currencies - skipped"); return; }
            Dictionary<int, string> tgtSname = new Dictionary<int, string>();
            foreach (DataRow r in GetTgt("SELECT code, sname FROM currency").Tables[0].Rows) tgtSname[Int(r["code"])] = Str(r["sname"]).Trim();
            int added = 0, updated = 0;
            foreach (DataRow r in GetSrc(@"SELECT ncurrency, ncurrencyvalue, nexchangerate FROM (
                                              SELECT d.ncurrency, d.ncurrencyvalue, d.nexchangerate,
                                                     ROW_NUMBER() OVER (PARTITION BY d.ncurrency ORDER BY d.deffectfrom DESC, d.ncode DESC) rn
                                              FROM msdexchangerate d WITH (NOLOCK)
                                              WHERE d.nofficeid IN (" + OfficeIn + ") AND d.nexchangecurrency = " + inrSrc + " AND d.ncurrency <> " + inrSrc + @" AND ISNULL(d.nexchangerate,0) > 0) x
                                           WHERE rn = 1").Tables[0].Rows)
            {
                int tc; string sn;
                if (!_mapCurrency.TryGetValue(Int(r["ncurrency"]), out tc) || !tgtSname.TryGetValue(tc, out sn) || sn.Length == 0) continue;
                decimal val = Dec(r["ncurrencyvalue"]); if (val <= 0) val = 1m;
                decimal rate = Math.Round(Dec(r["nexchangerate"]) / val, 4);
                using (SqlCommand u = new SqlCommand("UPDATE currencyconversion SET rate=@r, updatedby=@cb, updatedon=GETDATE() WHERE name=@n", tgt))
                {
                    u.Parameters.AddWithValue("@r", rate); u.Parameters.AddWithValue("@n", sn); u.Parameters.AddWithValue("@cb", MigrationUser);
                    if (u.ExecuteNonQuery() > 0) { updated++; continue; }
                }
                using (SqlCommand ins = new SqlCommand("INSERT INTO currencyconversion (name, rate, makedefault, createdby, createdon, updatedby, updatedon) VALUES (@n, @r, 0, @cb, GETDATE(), @cb, GETDATE())", tgt))
                { ins.Parameters.AddWithValue("@n", sn); ins.Parameters.AddWithValue("@r", rate); ins.Parameters.AddWithValue("@cb", MigrationUser); ins.ExecuteNonQuery(); added++; }
            }
            Console.WriteLine("  currencyconversion (latest eBizWiz rate to INR): " + added + " added, " + updated + " updated");
        }

        static void SeedCurrency(SqlConnection tgt)
        {
            Dictionary<string, int> byName = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
            Dictionary<string, int> bySname = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
            foreach (DataRow r in GetTgt("SELECT code, name, sname FROM currency").Tables[0].Rows)
            {
                int code = Int(r["code"]); string n = Str(r["name"]), s = Str(r["sname"]);
                if (n.Length > 0 && !byName.ContainsKey(n)) byName[n] = code;
                if (s.Length > 0 && !bySname.ContainsKey(s)) bySname[s] = code;
            }

            foreach (KeyValuePair<int, Curr> kv in _srcCurrency)
            {
                string n = (kv.Value.Name ?? "").Trim(), s = (kv.Value.Sname ?? "").Trim();
                int code;
                if (n.Length > 0 && byName.TryGetValue(n, out code)) { _mapCurrency[kv.Key] = code; continue; }
                if (s.Length > 0 && bySname.TryGetValue(s, out code)) { _mapCurrency[kv.Key] = code; continue; }
                if (n.Length == 0 && s.Length == 0) continue;
                using (SqlCommand ins = new SqlCommand("INSERT INTO currency (name, sname, createdby, updatedby, createdon, updatedon) OUTPUT INSERTED.code VALUES (@n, @s, @cb, @cb, GETDATE(), GETDATE())", tgt))
                {
                    ins.Parameters.AddWithValue("@n", PS(n.Length > 0 ? n : s));
                    ins.Parameters.AddWithValue("@s", PS(s.Length > 0 ? s : n));
                    ins.Parameters.AddWithValue("@cb", MigrationUser);
                    code = Convert.ToInt32(ins.ExecuteScalar());
                }
                byName[n] = code; if (s.Length > 0) bySname[s] = code;
                _mapCurrency[kv.Key] = code; _newCurrency++;
            }
        }

