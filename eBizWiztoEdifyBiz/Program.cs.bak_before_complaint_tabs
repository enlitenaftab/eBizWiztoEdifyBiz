        static Dictionary<int, string> _fixed, _inqCategory, _inqSource, _lostReason, _salesStage, _officeName;
        static Dictionary<int, string> _probability, _checkset, _checkName;                                   // remark names + check list - Aftab Alam
        static readonly Dictionary<string, string> _campaignName = new Dictionary<string, string>();          // office|trhcampa.ncode -> "CA2 - name"
        static readonly Dictionary<string, List<string>> _competitors = new Dictionary<string, List<string>>(); // office|inquiry -> competitor text (trdinqry3competitor; no competitor structure in this DB) - Aftab Alam
        static readonly Dictionary<string, List<object[]>> _checksByKey = new Dictionary<string, List<object[]>>();
