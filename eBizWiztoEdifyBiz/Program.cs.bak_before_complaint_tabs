            foreach (DataRow r in GetSrc("SELECT nofficeid, nsales, nmstpayterms, npercentage, namount FROM trdsales3payterms WITH (NOLOCK) WHERE nofficeid IN (" + OfficeIn + ") ORDER BY nofficeid, nsales, ncode").Tables[0].Rows)
