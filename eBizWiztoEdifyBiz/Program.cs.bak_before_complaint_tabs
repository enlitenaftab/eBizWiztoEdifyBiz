                string nm = LookInt(_payTermName, Int(r["nmstpayterms"])); if (nm.Length == 0) nm = "Term " + Int(r["nmstpayterms"]);
                string txt = nm;
                if (r["npercentage"] != DBNull.Value) txt += " " + Dec(r["npercentage"]).ToString("0.##", CultureInfo.InvariantCulture) + "%";
                if (r["namount"] != DBNull.Value) txt += " = " + Dec(r["namount"]).ToString("0.00", CultureInfo.InvariantCulture);
