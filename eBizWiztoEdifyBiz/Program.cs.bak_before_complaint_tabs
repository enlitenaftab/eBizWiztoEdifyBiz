        // Master > Inquiry (Inquiry Category / Inquiry Source / Lost Reason / Sales Stage) are seeded as full masters. The client
        // screens list only ACTIVE rows and our dropdowns read miscellaneous.active = 1, so a value that is inactive in eBizWiz
        // (and has no active row of the same name) gets active = 0: it no longer shows in the dropdown but documents that carry it
        // still show it on the view (views look the name up by code). - Aftab Alam
        static void SyncInquiryMasterActive(SqlConnection tgt)
        {
            string[,] m = { { "Category", "mstinquirycategory" }, { "Inquiry Source", "mstinquirysource" }, { "Loss Reason", "mstorderlostreason" }, { "Sales Stage", "mstsalesstage" } };
            for (int i = 0; i < m.GetLength(0); i++)
            {
                int off = 0;
                foreach (DataRow r in GetSrc("SELECT LTRIM(RTRIM(vname)) AS n FROM " + m[i, 1] + " WITH (NOLOCK) WHERE ISNULL(bactive,0) = 0 AND LTRIM(RTRIM(ISNULL(vname,''))) <> '' AND LTRIM(RTRIM(vname)) NOT IN (SELECT LTRIM(RTRIM(vname)) FROM " + m[i, 1] + " WITH (NOLOCK) WHERE bactive = 1 AND vname IS NOT NULL)").Tables[0].Rows)
                    using (SqlCommand u = new SqlCommand("UPDATE miscellaneous SET active = 0, updatedby = @cb, updatedon = GETDATE() WHERE module = 'Inquiry' AND type = @t AND name = @n AND ISNULL(active,1) = 1", tgt))
                    { u.Parameters.AddWithValue("@t", m[i, 0]); u.Parameters.AddWithValue("@n", Str(r["n"])); u.Parameters.AddWithValue("@cb", MigrationUser); off += u.ExecuteNonQuery(); }
                Console.WriteLine("  miscellaneous(Inquiry/" + m[i, 0] + ") set inactive as in eBizWiz: " + off);
            }
        }

        static void SeedSalesStageAndLostReason(SqlConnection tgt)
        {
            _mapSalesStage = SeedInqMiscMap(tgt, "Sales Stage", "nsalesstage", "trhinqry", _salesStage, true);
            _mapLostReason = SeedInqMiscMap(tgt, "Loss Reason", "nlostreasons", "trhinqry", _lostReason, true);
            _mapCallType = SeedInqMiscMap(tgt, "Call Type", "ninquiryby", "trhinqry", _fixed, false);
