                using (SqlCommand insCi = new SqlCommand("INSERT INTO city (name, countrycode, statecode, makedefault, createdby, updatedby, createdon, updatedon) OUTPUT INSERTED.code VALUES (@n, @cc, @sc, 0, @cb, @cb, GETDATE(), GETDATE())", tgt))
