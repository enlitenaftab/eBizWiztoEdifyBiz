        // ---------- maps ----------
        static void BuildMaps(SqlConnection tgt)
        {
            foreach (int office in Offices)
            {
                string nm; string place = _officeName.TryGetValue(office, out nm) && nm.Length > 0 ? Cap(nm, 100) : "Office " + office;
                using (SqlCommand q = new SqlCommand("SELECT code FROM companyaddress WHERE ccode=@cc AND place=@pl", tgt))
                { q.Parameters.AddWithValue("@cc", CompanyCode); q.Parameters.AddWithValue("@pl", place); object o = q.ExecuteScalar(); if (o != null && o != DBNull.Value) _branchByOffice[office] = Convert.ToInt32(o); }
            }
            Dictionary<string, int> cByName = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
            foreach (DataRow r in GetTgt("SELECT code, name FROM contact WITH (NOLOCK) ORDER BY isdeleted").Tables[0].Rows) { string n = Str(r["name"]); if (n.Length > 0 && !cByName.ContainsKey(n)) cByName[n] = Int(r["code"]); }
            foreach (DataRow r in GetSrc("SELECT ncode, ntitle, vname FROM mstparty WITH (NOLOCK) WHERE nofficeid IN (" + OfficeIn + ")").Tables[0].Rows)
            {
                string k = NKey(r["ncode"]); if (k.Length == 0) continue;
                string nm = Cap(Join(LookInt(_fixed, Int(r["ntitle"])), Str(r["vname"])), 150);
                int c; if (nm.Length > 0 && cByName.TryGetValue(nm, out c) && !_custByParty.ContainsKey(k)) _custByParty[k] = c;
            }
            foreach (KeyValuePair<string, int> kv in PartyToContact) _custByParty[kv.Key] = kv.Value;

            // Sales Invoice: (branch, salorderno) is unique in the target (5,707/5,707)
            Dictionary<string, int> invByKey = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
            foreach (DataRow r in GetTgt("SELECT code, branchcode, salorderno FROM sal_order WITH (NOLOCK) WHERE type='SO' AND salorderno IS NOT NULL").Tables[0].Rows)
            { string k = Int(r["branchcode"]) + "|" + Str(r["salorderno"]); if (!invByKey.ContainsKey(k)) invByKey[k] = Int(r["code"]); }
            foreach (DataRow r in GetSrc("SELECT nofficeid, ncode, vtrnprefix, ntrnno FROM trhsales WITH (NOLOCK) WHERE nofficeid IN (" + OfficeIn + ")").Tables[0].Rows)
            {
                int office = Int(r["nofficeid"]); string no = (Str(r["vtrnprefix"]) + Str(r["ntrnno"])).Trim();
                string sk = office + "|" + Int(r["ncode"]); _invNo[sk] = no;
                int br, ic; if (_branchByOffice.TryGetValue(office, out br) && invByKey.TryGetValue(br + "|" + no, out ic)) _invBySrc[sk] = ic;
            }

            // AMC schedule bills: contract (branch, contractno) -> amc.code, then module 10's billingno = BILL_<right10 contractno>_<n>,
            // n counted in the same order module 10 wrote them (bill date, then ncode). (amccode, billingno) is unique in the target.
            Dictionary<string, int> amcByKey = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
            foreach (DataRow r in GetTgt("SELECT code, branch, contractno FROM amc WITH (NOLOCK) WHERE contractno IS NOT NULL").Tables[0].Rows)
            { string k = Str(r["branch"]) + "|" + Str(r["contractno"]); if (!amcByKey.ContainsKey(k)) amcByKey[k] = Int(r["code"]); }
            Dictionary<string, int> billByKey = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
            //foreach (DataRow r in GetTgt("SELECT code, amccode, billingno FROM billingcycle WITH (NOLOCK) WHERE billingno IS NOT NULL").Tables[0].Rows)
            //{ string k = Int(r["amccode"]) + "|" + Str(r["billingno"]); if (!billByKey.ContainsKey(k)) billByKey[k] = Int(r["code"]); }
            Dictionary<int, int> invByBill = new Dictionary<int, int>();   // billingcycle.code -> salcode - Aftab Alam
            foreach (DataRow r in GetTgt("SELECT code, amccode, billingno, ISNULL(salcode,0) AS salcode FROM billingcycle WITH (NOLOCK) WHERE billingno IS NOT NULL").Tables[0].Rows)
            { string k = Int(r["amccode"]) + "|" + Str(r["billingno"]); if (!billByKey.ContainsKey(k)) { billByKey[k] = Int(r["code"]); invByBill[Int(r["code"])] = Int(r["salcode"]); } }
            Dictionary<string, string> contrNo = new Dictionary<string, string>();
            foreach (DataRow r in GetSrc("SELECT nofficeid, ncode, vtrnprefix, ntrnno FROM trhcontr WITH (NOLOCK) WHERE nofficeid IN (" + OfficeIn + ")").Tables[0].Rows)
                contrNo[Int(r["nofficeid"]) + "|" + Int(r["ncode"])] = (Str(r["vtrnprefix"]) + Str(r["ntrnno"])).Trim();
            Dictionary<string, int> seq = new Dictionary<string, int>();
            foreach (DataRow r in GetSrc("SELECT nofficeid, ncode, ncontr, nbillno, dbilldate FROM trdcontr3bills WITH (NOLOCK) WHERE nofficeid IN (" + OfficeIn + ") ORDER BY nofficeid, ncontr, dbilldate, ncode").Tables[0].Rows)
            {
                int office = Int(r["nofficeid"]);
                string ckey = office + "|" + Int(r["ncontr"]); string cno;
                if (!contrNo.TryGetValue(ckey, out cno)) continue;
                int i; seq.TryGetValue(ckey, out i); seq[ckey] = i + 1;                   // 1-based, exactly as module 10 numbered them
                int br, amccode;
                if (!_branchByOffice.TryGetValue(office, out br) || !amcByKey.TryGetValue(br + "|" + cno, out amccode)) continue;
                string pad = ("0000000000" + cno); pad = pad.Substring(pad.Length - 10);
                int bc; if (!billByKey.TryGetValue(amccode + "|BILL_" + pad + "_" + (i + 1), out bc)) continue;
                //_billBySrc[office + "|" + Int(r["ncode"])] = new Bill { Code = bc, ContractNo = cno, BillNo = Str(r["nbillno"]), Date = P(r["dbilldate"]) };
                int inv; invByBill.TryGetValue(bc, out inv);
                _billBySrc[office + "|" + Int(r["ncode"])] = new Bill { Code = bc, Invoice = inv, ContractNo = cno, BillNo = Str(r["nbillno"]), Date = P(r["dbilldate"]) };
            }

            // Complaints: module 11 wrote the call number into pmscomplaintno (unique)
            HashSet<string> callInTgt = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            foreach (DataRow r in GetTgt("SELECT pmscomplaintno FROM contractcall WITH (NOLOCK) WHERE pmscomplaintno IS NOT NULL").Tables[0].Rows)
                callInTgt.Add(Str(r["pmscomplaintno"]));
            foreach (DataRow r in GetSrc("SELECT nofficeid, ncode, vtrnno, vtrnprefix, ntrnno FROM trhcalls WITH (NOLOCK) WHERE nofficeid IN (" + OfficeIn + ")").Tables[0].Rows)
            {
                string no = Str(r["vtrnno"]); if (no.Length == 0) no = (Str(r["vtrnprefix"]) + Str(r["ntrnno"])).Trim();
                if (no.Length > 0 && callInTgt.Contains(no)) _callNo[Int(r["nofficeid"]) + "|" + Int(r["ncode"])] = no;
            }

            // Service call bills: invoices labelled "Service Call Bill" (CallBillInvoice), keyed branch|bill no; bill no = vinvoiceprefix + ninvoiceno.
            // Looked up by the label, because 11 call bills have no prefix and could share a number with an AMC bill of the same branch. - Aftab Alam
            Dictionary<string, int> callInv = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
            foreach (DataRow r in GetTgt("SELECT s.code, s.branchcode, s.salorderno FROM sal_order s JOIN labelrelation lr ON lr.module = s.code JOIN label l ON l.code = lr.label WHERE l.category = 'SAL' AND l.name = '" + CallBillInvoice.LabelName + "'").Tables[0].Rows)
            { string k = Int(r["branchcode"]) + "|" + Str(r["salorderno"]); if (!callInv.ContainsKey(k)) callInv[k] = Int(r["code"]); }
            foreach (DataRow r in GetSrc("SELECT nofficeid, ncode, vinvoiceprefix, ninvoiceno FROM trhcalls WITH (NOLOCK) WHERE nofficeid IN (" + OfficeIn + ") AND ISNULL(ninvoiceno,0) <> 0").Tables[0].Rows)
            {
                int office = Int(r["nofficeid"]), br, ic;
                string no = (Str(r["vinvoiceprefix"]) + Int(r["ninvoiceno"]).ToString(CultureInfo.InvariantCulture)).Trim();
                if (_branchByOffice.TryGetValue(office, out br) && callInv.TryGetValue(br + "|" + no, out ic)) _callInvBySrc[office + "|" + Int(r["ncode"])] = ic;
            }
        }

        static string Join(string a, string b) { return string.Join(" ", new[] { a, b }.Where(s => !string.IsNullOrWhiteSpace(s))).Trim(); }
    }
    // ==================================================================
    //  EXPENSES : trhexpense / trdexpense1detail (+ mstexpensetype) -> expense / expensedetails (+ ExpCategory, expensestatus)
    //  Standard Expense module (expense/app/expense.asp): header = date, executive (Employee), currency; lines = date, expense
    //  type (ExpCategory), amount (+ requestedamount, as addexpensedetails does), narration (remark). Status: eBizWiz approval
    //  flag set -> 'Sanctioned' (expenselevel 2) + one expensestatus history row, else NULL ("Not Entered"). expenseno keeps the
    //  eBizWiz number (UE1). The header has no remark column -> the header remark is added to its first line.
    //  Mapping: Maping\15_campaign_target_expense_claim_mapping.md. - Aftab Alam
    // ==================================================================
    static class ExpenseEntry
    {
        static int _rows, _lines, _types, _sanctioned, _errors;

        public static void Run()
        {
            Console.WriteLine("=====================================================");
            Console.WriteLine("   eBizWiz  ->  EdifyBiz   |   Master > Expenses -> Expense (expense / expensedetails)");
            Console.WriteLine("   Offices in scope: " + OfficeIn);
            Console.WriteLine("=====================================================");
            EnsureUserByCode();
            using (SqlConnection tgt = OpenTgt())
            {
                int inr = SalesInvoice.InrCode(tgt);
                // expense type master: full eBizWiz list by name
                Dictionary<int, int> typeMap = new Dictionary<int, int>();
                Dictionary<string, int> have = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
                foreach (DataRow r in GetTgt("SELECT code, name FROM ExpCategory").Tables[0].Rows) { string n = Str(r["name"]).Trim(); if (n.Length > 0 && !have.ContainsKey(n)) have[n] = Int(r["code"]); }
                foreach (DataRow r in GetSrc("SELECT ncode, vname FROM mstexpensetype WITH (NOLOCK) ORDER BY ncode").Tables[0].Rows)
                {
                    string n = Cap(Str(r["vname"]).Trim(), 50); if (n.Length == 0) continue;
                    int c;
                    if (!have.TryGetValue(n, out c))
                    {
                        using (SqlCommand ins = new SqlCommand("INSERT INTO ExpCategory (name, createdby, createdon, updatedby, updatedon) OUTPUT INSERTED.code VALUES (@n, @cb, GETDATE(), @cb, GETDATE())", tgt))
                        { ins.Parameters.AddWithValue("@n", n); ins.Parameters.AddWithValue("@cb", MigrationUser); c = Convert.ToInt32(ins.ExecuteScalar()); }
                        have[n] = c; _types++;
                    }
                    typeMap[Int(r["ncode"])] = c;
                }
                Console.WriteLine("  ExpCategory (expense type) seeded: " + _types + " (full eBizWiz master)");

                DataTable lines = GetSrc("SELECT nofficeid, nexpense, nexpensetype, dexpdate, namount, vremarks, addedon, editedon FROM trdexpense1detail WITH (NOLOCK) WHERE nofficeid IN (" + OfficeIn + ") ORDER BY nofficeid, nexpense, ncode").Tables[0];
                foreach (DataRow h in GetSrc("SELECT nofficeid, ncode, vtrnprefix, ntrnno, dtrndate, bapproval, vremarks, nuser, addedby, addedon, editedon FROM trhexpense WITH (NOLOCK) WHERE nofficeid IN (" + OfficeIn + ") ORDER BY nofficeid, ncode").Tables[0].Rows)
                {
                    int office = Int(h["nofficeid"]), src = Int(h["ncode"]);
                    using (SqlTransaction tx = tgt.BeginTransaction())
                    {
                        try
                        {
                            int u; object exec = UserByCode.TryGetValue(NKey(h["nuser"]), out u) ? (object)u : (UserByCode.TryGetValue(NKey(h["addedby"]), out u) ? (object)u : MigrationUser);
                            bool approved = Bool(h["bapproval"]);
                            object createdon = P(h["addedon"]);
                            object updatedon = h["editedon"] != DBNull.Value ? h["editedon"] : createdon;
                            int code;
                            using (SqlCommand c = new SqlCommand(@"INSERT INTO expense (date, executive, currency, status, statusupdatedby, statusupdatedon, expenselevel, expenseno, tallyexport, isexporttotecexcel, createdby, createdon, updatedby, updatedon)
                                                                 OUTPUT INSERTED.code VALUES (@dt, @ex, @cur, @st, @sb, @so, @lvl, @no, 0, 0, @cb, @con, @cb, @uon)", tgt, tx))
                            {
                                c.Parameters.AddWithValue("@dt", P(h["dtrndate"]));
                                c.Parameters.AddWithValue("@ex", exec);
                                c.Parameters.AddWithValue("@cur", inr > 0 ? (object)inr : DBNull.Value);
                                c.Parameters.AddWithValue("@st", approved ? (object)"Sanctioned" : DBNull.Value);
                                c.Parameters.AddWithValue("@sb", approved ? (object)MigrationUser : DBNull.Value);
                                c.Parameters.AddWithValue("@so", approved ? updatedon : DBNull.Value);
                                c.Parameters.AddWithValue("@lvl", approved ? (object)2 : DBNull.Value);
                                c.Parameters.AddWithValue("@no", PS(Cap((Str(h["vtrnprefix"]) + Str(h["ntrnno"])).Trim(), 255)));
                                c.Parameters.AddWithValue("@cb", MigrationUser);
                                c.Parameters.AddWithValue("@con", createdon);
                                c.Parameters.AddWithValue("@uon", updatedon);
                                code = Convert.ToInt32(c.ExecuteScalar());
                            }
                            string hdrRemark = Str(h["vremarks"]).Trim();
                            bool first = true;
                            foreach (DataRow l in lines.Select("nofficeid = " + office + " AND nexpense = " + src))
                            {
                                int t; object etype = typeMap.TryGetValue(Int(l["nexpensetype"]), out t) ? (object)t : DBNull.Value;
                                string rem = Str(l["vremarks"]).Trim();
                                if (first && hdrRemark.Length > 0) rem = (rem.Length > 0 ? rem + " | " : "") + "Expense remark: " + hdrRemark;
                                using (SqlCommand d = new SqlCommand(@"INSERT INTO expensedetails (expensecode, expensetype, amount, requestedamount, remark, date, currency, createdby, createdon, updatedby, updatedon)
                                                                     VALUES (@e, @t, @a, @a, @r, @dt, @cur, @cb, @con, @cb, @uon)", tgt, tx))
                                {
                                    d.Parameters.AddWithValue("@e", code);
                                    d.Parameters.AddWithValue("@t", etype);
                                    d.Parameters.AddWithValue("@a", Dec(l["namount"]));
                                    d.Parameters.AddWithValue("@r", PS(rem));
                                    d.Parameters.AddWithValue("@dt", l["dexpdate"] != DBNull.Value ? l["dexpdate"] : P(h["dtrndate"]));
                                    d.Parameters.AddWithValue("@cur", inr > 0 ? (object)inr : DBNull.Value);
                                    d.Parameters.AddWithValue("@cb", MigrationUser);
                                    d.Parameters.AddWithValue("@con", l["addedon"] != DBNull.Value ? l["addedon"] : createdon);
